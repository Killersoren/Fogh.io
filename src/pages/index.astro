---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="BALD SOFTWARE GUY" description="The most epic bald software developer you'll ever meet" />
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap');
			
			:root {
				--neon-blue: #00ffff;
				--neon-pink: #ff00ff;
				--neon-green: #00ff00;
				--dark-bg: #0a0a0a;
				--matrix-green: #00ff41;
				--cyber-purple: #8a2be2;
			}

			body {
				background: var(--dark-bg);
				color: white;
				font-family: 'Space Mono', monospace;
				margin: 0;
				overflow-x: hidden;
			}

			.hero-section {
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				position: relative;
				background: linear-gradient(45deg, #000000, #1a1a1a, #000000);
				overflow: hidden;
			}

			.matrix-bg {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				opacity: 0.1;
				z-index: 1;
			}

			.hero-content {
				text-align: center;
				z-index: 10;
				position: relative;
			}

			.bald-guy-title {
				font-family: 'Orbitron', monospace;
				font-size: 4rem;
				font-weight: 900;
				background: linear-gradient(45deg, var(--neon-blue), var(--neon-pink), var(--neon-green));
				background-size: 200% 200%;
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				animation: neonGlow 3s ease-in-out infinite, titleFloat 6s ease-in-out infinite;
				text-shadow: 0 0 20px var(--neon-blue), 0 0 40px var(--neon-blue);
				margin-bottom: 2rem;
			}

			.subtitle {
				font-size: 1.5rem;
				color: var(--matrix-green);
				margin-bottom: 3rem;
				animation: pulse 2s ease-in-out infinite;
			}

			.bald-avatar {
				width: 200px;
				height: 200px;
				border-radius: 50%;
				background: linear-gradient(45deg, var(--neon-blue), var(--neon-pink));
				margin: 0 auto 2rem;
				position: relative;
				animation: rotate 20s linear infinite, glow 2s ease-in-out infinite alternate;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 4rem;
			}

			.tech-stack {
				display: flex;
				justify-content: center;
				gap: 2rem;
				flex-wrap: wrap;
				margin: 3rem 0;
			}

			.tech-item {
				padding: 1rem 2rem;
				background: rgba(0, 255, 255, 0.1);
				border: 2px solid var(--neon-blue);
				border-radius: 10px;
				color: var(--neon-blue);
				font-weight: bold;
				animation: techFloat 4s ease-in-out infinite;
				cursor: pointer;
				transition: all 0.3s ease;
			}

			.tech-item:hover {
				background: var(--neon-blue);
				color: var(--dark-bg);
				transform: scale(1.1);
				box-shadow: 0 0 30px var(--neon-blue);
			}

			.cta-button {
				padding: 1rem 3rem;
				font-size: 1.2rem;
				font-weight: bold;
				background: linear-gradient(45deg, var(--neon-pink), var(--neon-blue));
				border: none;
				border-radius: 50px;
				color: white;
				cursor: pointer;
				animation: buttonPulse 2s ease-in-out infinite;
				transition: all 0.3s ease;
				text-transform: uppercase;
				letter-spacing: 2px;
			}

			.cta-button:hover {
				transform: scale(1.05);
				box-shadow: 0 0 40px var(--neon-pink);
			}

			.floating-elements {
				position: absolute;
				width: 100%;
				height: 100%;
				pointer-events: none;
				z-index: 5;
			}

			.floating-element {
				position: absolute;
				color: var(--matrix-green);
				font-size: 2rem;
				animation: float 8s ease-in-out infinite;
				opacity: 0.3;
			}

			@keyframes neonGlow {
				0%, 100% { background-position: 0% 50%; }
				50% { background-position: 100% 50%; }
			}

			@keyframes titleFloat {
				0%, 100% { transform: translateY(0px); }
				50% { transform: translateY(-10px); }
			}

			@keyframes pulse {
				0%, 100% { opacity: 1; }
				50% { opacity: 0.7; }
			}

			@keyframes rotate {
				from { transform: rotate(0deg); }
				to { transform: rotate(360deg); }
			}

			@keyframes glow {
				from { box-shadow: 0 0 20px var(--neon-blue); }
				to { box-shadow: 0 0 40px var(--neon-pink), 0 0 60px var(--neon-green); }
			}

			@keyframes techFloat {
				0%, 100% { transform: translateY(0px); }
				50% { transform: translateY(-5px); }
			}

			@keyframes buttonPulse {
				0%, 100% { transform: scale(1); }
				50% { transform: scale(1.05); }
			}

			@keyframes float {
				0%, 100% { transform: translateY(0px) rotate(0deg); }
				50% { transform: translateY(-20px) rotate(180deg); }
			}

			@media (max-width: 768px) {
				.bald-guy-title {
					font-size: 2.5rem;
				}
				.subtitle {
					font-size: 1.2rem;
				}
				.bald-avatar {
					width: 150px;
					height: 150px;
					font-size: 3rem;
				}
				.tech-stack {
					gap: 1rem;
				}
				.tech-item {
					padding: 0.8rem 1.5rem;
					font-size: 0.9rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		
		<section class="hero-section">
			<div class="matrix-bg">
				<!-- Matrix rain effect will be added via JavaScript -->
			</div>
			
			<div class="floating-elements">
				<div class="floating-element" style="top: 10%; left: 10%; animation-delay: 0s;">{ }</div>
				<div class="floating-element" style="top: 20%; right: 15%; animation-delay: 1s;">&lt;/&gt;</div>
				<div class="floating-element" style="bottom: 30%; left: 20%; animation-delay: 2s;">()</div>
				<div class="floating-element" style="bottom: 20%; right: 10%; animation-delay: 3s;">[]</div>
				<div class="floating-element" style="top: 50%; left: 5%; animation-delay: 4s;">//</div>
				<div class="floating-element" style="top: 60%; right: 5%; animation-delay: 5s;">&&</div>
			</div>

			<div class="hero-content">
				<div class="bald-avatar">👨‍🦲</div>
				<h1 class="bald-guy-title">BALD SOFTWARE GUY</h1>
				<p class="subtitle">Coding with style, debugging with grace, and absolutely owning the bald aesthetic</p>
				
				<div class="tech-stack">
					<div class="tech-item">JavaScript</div>
					<div class="tech-item">TypeScript</div>
					<div class="tech-item">React</div>
					<div class="tech-item">Node.js</div>
					<div class="tech-item">Python</div>
					<div class="tech-item">AWS</div>
				</div>
				
				<button class="cta-button" onclick="scrollToAbout()">Explore My Code</button>
			</div>
		</section>

		<main>
			<section id="about" style="padding: 4rem 0; background: linear-gradient(135deg, #1a1a1a, #2a2a2a);">
				<div style="max-width: 1200px; margin: 0 auto; padding: 0 2rem;">
					<h2 style="text-align: center; font-family: 'Orbitron', monospace; font-size: 3rem; color: var(--neon-blue); margin-bottom: 3rem; text-shadow: 0 0 20px var(--neon-blue);">
						WHO IS THIS BALD LEGEND?
					</h2>
					
					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; margin-top: 3rem;">
						<div style="background: rgba(0, 255, 255, 0.1); padding: 2rem; border-radius: 15px; border: 2px solid var(--neon-blue);">
							<h3 style="color: var(--neon-blue); font-family: 'Orbitron', monospace; margin-bottom: 1rem;">🚀 Full-Stack Developer</h3>
							<p>Building web applications that are as smooth as my head. From frontend to backend, I make it all work seamlessly.</p>
						</div>
						
						<div style="background: rgba(255, 0, 255, 0.1); padding: 2rem; border-radius: 15px; border: 2px solid var(--neon-pink);">
							<h3 style="color: var(--neon-pink); font-family: 'Orbitron', monospace; margin-bottom: 1rem;">🎯 Problem Solver</h3>
							<p>Debugging is my superpower. I find bugs faster than you can say "it works on my machine."</p>
						</div>
						
						<div style="background: rgba(0, 255, 0, 0.1); padding: 2rem; border-radius: 15px; border: 2px solid var(--neon-green);">
							<h3 style="color: var(--neon-green); font-family: 'Orbitron', monospace; margin-bottom: 1rem;">💡 Innovation Enthusiast</h3>
							<p>Always exploring new technologies and pushing the boundaries of what's possible in software development.</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			// Matrix rain effect
			function createMatrixRain() {
				const matrixBg = document.querySelector('.matrix-bg');
				const characters = '01アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン';
				
				for (let i = 0; i < 50; i++) {
					const span = document.createElement('span');
					span.textContent = characters[Math.floor(Math.random() * characters.length)];
					span.style.position = 'absolute';
					span.style.left = Math.random() * 100 + '%';
					span.style.top = Math.random() * 100 + '%';
					span.style.color = '#00ff41';
					span.style.fontSize = '1.5rem';
					span.style.opacity = '0.3';
					span.style.animation = `float ${8 + Math.random() * 4}s ease-in-out infinite`;
					span.style.animationDelay = Math.random() * 5 + 's';
					matrixBg.appendChild(span);
				}
			}

			// Smooth scroll function
			function scrollToAbout() {
				document.getElementById('about').scrollIntoView({
					behavior: 'smooth'
				});
			}

			// Initialize effects when page loads
			document.addEventListener('DOMContentLoaded', function() {
				createMatrixRain();
				
				// Add some interactive effects
				const techItems = document.querySelectorAll('.tech-item');
				techItems.forEach(item => {
					item.addEventListener('mouseenter', function() {
						this.style.animation = 'none';
						setTimeout(() => {
							this.style.animation = 'techFloat 4s ease-in-out infinite';
						}, 10);
					});
				});
			});
		</script>
	</body>
</html>
