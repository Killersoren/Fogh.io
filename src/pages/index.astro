---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Esben Fogh – Software Engineer" description="Diplomingeniør i Software Teknologi specialising in RPA, automation & full-stack development." />
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap');
			
			:root {
				--neon-blue: #00ffff;
				--neon-pink: #ff00ff;
				--neon-green: #00ff00;
				--dark-bg: #0a0a0a;
				--matrix-green: #00ff41;
				--cyber-purple: #8a2be2;
				--gold: #ffd700;
				--orange: #ff6600;
				/* SUPER GAY COLORS */
				--rainbow-red: #ff0000;
				--rainbow-orange: #ff8000;
				--rainbow-yellow: #ffff00;
				--rainbow-green: #00ff00;
				--rainbow-blue: #0080ff;
				--rainbow-purple: #8000ff;
				--rainbow-pink: #ff0080;
			}

			body {
				background: var(--dark-bg);
				color: white;
				font-family: 'Space Mono', monospace;
				margin: 0;
				overflow-x: hidden;
				cursor:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32'><text x='0' y='24' font-size='24'>🧑‍🦲</text></svg>") 16 16, auto;
			}

			/* === DICK CONFETTI 2.0 === */
			.dick-confetti-container {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				pointer-events: none;
				z-index: 100;
				overflow: hidden;
			}

			.dick-rocket {
				position: absolute;
				width: 14px;
				height: 14px;
				border-radius: 50%;
				filter: drop-shadow(0 0 6px currentColor);
				animation: rocketMove 1s ease-out forwards;
			}

			.dick-firework::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: currentColor;
				border-radius: 50%;
				animation: fireworkGlow 0.5s ease-out infinite;
			}

			.dick-explosion {
				position: absolute;
				animation: dickExplosion 2s ease-out forwards;
			}

			.dick-particle {
				position: absolute;
				font-size: 1.3rem;
				animation: particleMove 1.6s ease-out forwards;
			}

			.dick-particle:nth-child(odd) { color: var(--rainbow-pink); }
			.dick-particle:nth-child(even) { color: var(--rainbow-blue); }
			.dick-particle:nth-child(3n) { color: var(--rainbow-green); }
			.dick-particle:nth-child(4n) { color: var(--rainbow-yellow); }
			.dick-particle:nth-child(5n) { color: var(--rainbow-purple); }
			.dick-particle:nth-child(6n) { color: var(--rainbow-orange); }

			/* FIREWORK TRAIL EFFECT */
			.dick-firework::after {
				content: '';
				position: absolute;
				top: 50%;
				left: 50%;
				width: 2px;
				height: 20px;
				background: linear-gradient(to bottom, currentColor, transparent);
				transform: translate(-50%, -50%);
				animation: fireworkTrail 0.5s ease-out infinite;
			}

			/* RAINBOW PARTICLE BACKGROUND */
			.particle-container {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				z-index: 1;
				pointer-events: none;
			}

			.particle {
				position: absolute;
				width: 4px;
				height: 4px;
				border-radius: 50%;
				animation: particleFloat 8s linear infinite;
			}

			.particle:nth-child(6n+1) { background: var(--rainbow-red); animation-duration: 6s; }
			.particle:nth-child(6n+2) { background: var(--rainbow-orange); animation-duration: 7s; }
			.particle:nth-child(6n+3) { background: var(--rainbow-yellow); animation-duration: 8s; }
			.particle:nth-child(6n+4) { background: var(--rainbow-green); animation-duration: 9s; }
			.particle:nth-child(6n+5) { background: var(--rainbow-blue); animation-duration: 10s; }
			.particle:nth-child(6n+6) { background: var(--rainbow-purple); animation-duration: 11s; }

			/* RAINBOW SCANNING LINES */
			.scan-line {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 2px;
				z-index: 2;
				animation: scanLine 3s linear infinite;
			}

			.scan-line:nth-child(1) {
				background: linear-gradient(90deg, transparent, var(--rainbow-red), transparent);
			}

			.scan-line:nth-child(2) {
				animation-delay: 1s;
				background: linear-gradient(90deg, transparent, var(--rainbow-orange), transparent);
			}

			.scan-line:nth-child(3) {
				animation-delay: 2s;
				background: linear-gradient(90deg, transparent, var(--rainbow-yellow), transparent);
			}

			.scan-line:nth-child(4) {
				animation-delay: 3s;
				background: linear-gradient(90deg, transparent, var(--rainbow-green), transparent);
			}

			.scan-line:nth-child(5) {
				animation-delay: 4s;
				background: linear-gradient(90deg, transparent, var(--rainbow-blue), transparent);
			}

			.scan-line:nth-child(6) {
				animation-delay: 5s;
				background: linear-gradient(90deg, transparent, var(--rainbow-purple), transparent);
			}

			.hero-section {
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				position: relative;
				background: linear-gradient(45deg, #000000, #1a1a1a, #000000);
				overflow: hidden;
				z-index: 10;
			}

			/* RAINBOW MATRIX BACKGROUND */
			.matrix-bg {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				opacity: 0.3;
				z-index: 1;
			}

			.matrix-column {
				position: absolute;
				top: -100%;
				font-size: 1.2rem;
				font-family: 'Space Mono', monospace;
				animation: matrixRain 8s linear infinite;
				text-shadow: 0 0 10px currentColor;
			}

			.matrix-column:nth-child(6n+1) { color: var(--rainbow-red); }
			.matrix-column:nth-child(6n+2) { color: var(--rainbow-orange); }
			.matrix-column:nth-child(6n+3) { color: var(--rainbow-yellow); }
			.matrix-column:nth-child(6n+4) { color: var(--rainbow-green); }
			.matrix-column:nth-child(6n+5) { color: var(--rainbow-blue); }
			.matrix-column:nth-child(6n+6) { color: var(--rainbow-purple); }

			/* RAINBOW FLASHING BORDER EFFECT */
			.hero-section::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				border: 3px solid transparent;
				background: linear-gradient(45deg, var(--rainbow-red), var(--rainbow-orange), var(--rainbow-yellow), var(--rainbow-green), var(--rainbow-blue), var(--rainbow-purple)) border-box;
				-webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
				-webkit-mask-composite: destination-out;
				mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
				mask-composite: exclude;
				animation: rainbowBorderRotate 4s linear infinite;
			}

			.hero-content {
				text-align: center;
				z-index: 20;
				position: relative;
			}

			.bald-guy-title {
				font-family: 'Orbitron', monospace;
				font-size: 5rem;
				font-weight: 900;
				background: linear-gradient(45deg, var(--rainbow-red), var(--rainbow-orange), var(--rainbow-yellow), var(--rainbow-green), var(--rainbow-blue), var(--rainbow-purple));
				background-size: 300% 300%;
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				animation: neonGlow 2s ease-in-out infinite, titleFloat 4s ease-in-out infinite, titlePulse 1s ease-in-out infinite;
				/* 2000s retro 3D stacked shadow */
				text-shadow:
					1px 1px 0 #ff00ff,
					2px 2px 0 #cc00ff,
					3px 3px 0 #9900ff,
					4px 4px 0 #6600ff,
					5px 5px 0 #3300ff,
					6px 6px 15px rgba(0,0,0,0.6),
					0 0 20px var(--rainbow-pink),
					0 0 40px var(--rainbow-pink),
					0 0 60px var(--rainbow-pink),
					0 0 80px var(--rainbow-pink);
				margin-bottom: 2rem;
				position: relative;
			}

			.bald-guy-title::before {
				content: 'ESBEN FOGH';
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: linear-gradient(45deg, var(--rainbow-purple), var(--rainbow-blue), var(--rainbow-green));
				background-size: 300% 300%;
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				animation: neonGlow 2s ease-in-out infinite reverse;
				filter: blur(3px);
				z-index: -1;
			}

			.subtitle {
				font-size: 1.8rem;
				color: var(--rainbow-yellow);
				margin-bottom: 3rem;
				animation: pulse 1.5s ease-in-out infinite, glowText 3s ease-in-out infinite;
				text-shadow: 0 0 15px var(--rainbow-yellow);
			}

			.bald-avatar {
				width: 250px;
				height: 250px;
				border-radius: 50%;
				background: linear-gradient(45deg, var(--rainbow-red), var(--rainbow-orange), var(--rainbow-yellow), var(--rainbow-green), var(--rainbow-blue), var(--rainbow-purple));
				background-size: 400% 400%;
				margin: 0 auto 2rem;
				position: relative;
				animation: rotate 15s linear infinite, glow 1s ease-in-out infinite alternate, avatarPulse 2s ease-in-out infinite;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 5rem;
				box-shadow: 
					0 0 30px var(--rainbow-pink),
					0 0 60px var(--rainbow-blue),
					0 0 90px var(--rainbow-green);
			}

			.bald-avatar::before {
				content: '';
				position: absolute;
				top: -10px;
				left: -10px;
				right: -10px;
				bottom: -10px;
				border-radius: 50%;
				background: linear-gradient(45deg, var(--rainbow-red), var(--rainbow-orange), var(--rainbow-yellow), var(--rainbow-green), var(--rainbow-blue), var(--rainbow-purple));
				background-size: 400% 400%;
				animation: rotate 10s linear infinite reverse, glow 1.5s ease-in-out infinite alternate;
				z-index: -1;
				filter: blur(10px);
			}

			.tech-stack {
				display: flex;
				justify-content: center;
				gap: 2rem;
				flex-wrap: wrap;
				margin: 3rem 0;
			}

			.tech-item {
				padding: 1.5rem 2.5rem;
				background: rgba(255, 0, 255, 0.1);
				border: 3px solid var(--rainbow-pink);
				border-radius: 15px;
				color: var(--rainbow-pink);
				font-weight: bold;
				font-size: 1.1rem;
				animation: techFloat 3s ease-in-out infinite, techGlow 2s ease-in-out infinite;
				cursor: pointer;
				transition: all 0.3s ease;
				position: relative;
				overflow: hidden;
				text-shadow: 0 0 10px var(--rainbow-pink);
			}

			.tech-item::before {
				content: '';
				position: absolute;
				top: 0;
				left: -100%;
				width: 100%;
				height: 100%;
				background: linear-gradient(90deg, transparent, rgba(255, 0, 255, 0.5), transparent);
				transition: left 0.5s ease;
			}

			.tech-item:hover {
				background: var(--rainbow-pink);
				color: var(--dark-bg);
				transform: scale(1.2) rotate(5deg);
				box-shadow: 
					0 0 30px var(--rainbow-pink),
					0 0 60px var(--rainbow-pink);
				border-color: var(--rainbow-blue);
			}

			.tech-item:hover::before {
				left: 100%;
			}

			.cta-button {
				padding: 1.5rem 4rem;
				font-size: 1.4rem;
				font-weight: bold;
				background: linear-gradient(45deg, var(--rainbow-red), var(--rainbow-orange), var(--rainbow-yellow), var(--rainbow-green), var(--rainbow-blue), var(--rainbow-purple));
				background-size: 200% 200%;
				border: none;
				border-radius: 50px;
				color: white;
				cursor: pointer;
				animation: buttonPulse 1.5s ease-in-out infinite, buttonGlow 2s ease-in-out infinite;
				transition: all 0.3s ease;
				text-transform: uppercase;
				letter-spacing: 3px;
				position: relative;
				overflow: hidden;
				box-shadow: 
					0 0 20px var(--rainbow-pink),
					0 0 40px var(--rainbow-blue);
			}

			.cta-button::before {
				content: '';
				position: absolute;
				top: 0;
				left: -100%;
				width: 100%;
				height: 100%;
				background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
				transition: left 0.5s ease;
			}

			.cta-button:hover {
				transform: scale(1.1);
				box-shadow: 
					0 0 40px var(--rainbow-pink),
					0 0 80px var(--rainbow-blue),
					0 0 120px var(--rainbow-green);
			}

			.cta-button:hover::before {
				left: 100%;
			}

			.floating-elements {
				position: absolute;
				width: 100%;
				height: 100%;
				pointer-events: none;
				z-index: 5;
			}

			.floating-element {
				position: absolute;
				font-size: 3rem;
				animation: float 6s ease-in-out infinite;
				opacity: 0.4;
				text-shadow: 0 0 15px currentColor;
			}

			.floating-element:nth-child(6n+1) { color: var(--rainbow-red); }
			.floating-element:nth-child(6n+2) { color: var(--rainbow-orange); }
			.floating-element:nth-child(6n+3) { color: var(--rainbow-yellow); }
			.floating-element:nth-child(6n+4) { color: var(--rainbow-green); }
			.floating-element:nth-child(6n+5) { color: var(--rainbow-blue); }
			.floating-element:nth-child(6n+6) { color: var(--rainbow-purple); }

			/* SUPER GAY ANIMATIONS */
			@keyframes dickFall {
				0% { 
					transform: translateY(-100vh) translateX(0px) rotate(0deg); 
					opacity: 0; 
				}
				10% { opacity: 1; }
				90% { opacity: 1; }
				100% { 
					transform: translateY(100vh) translateX(100px) rotate(360deg); 
					opacity: 0; 
				}
			}

			@keyframes neonGlow {
				0%, 100% { background-position: 0% 50%; }
				50% { background-position: 100% 50%; }
			}

			@keyframes titleFloat {
				0%, 100% { transform: translateY(0px) rotate(0deg); }
				50% { transform: translateY(-15px) rotate(1deg); }
			}

			@keyframes titlePulse {
				0%, 100% { transform: scale(1); }
				50% { transform: scale(1.05); }
			}

			@keyframes pulse {
				0%, 100% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.8; transform: scale(1.02); }
			}

			@keyframes glowText {
				0%, 100% { text-shadow: 0 0 15px var(--rainbow-yellow); }
				50% { text-shadow: 0 0 30px var(--rainbow-yellow), 0 0 45px var(--rainbow-yellow); }
			}

			@keyframes rotate {
				from { transform: rotate(0deg); }
				to { transform: rotate(360deg); }
			}

			@keyframes glow {
				from { 
					box-shadow: 
						0 0 20px var(--rainbow-pink),
						0 0 40px var(--rainbow-blue);
				}
				to { 
					box-shadow: 
						0 0 40px var(--rainbow-blue),
						0 0 60px var(--rainbow-green),
						0 0 80px var(--rainbow-yellow);
				}
			}

			@keyframes avatarPulse {
				0%, 100% { transform: scale(1); }
				50% { transform: scale(1.1); }
			}

			@keyframes techFloat {
				0%, 100% { transform: translateY(0px) rotate(0deg); }
				50% { transform: translateY(-8px) rotate(2deg); }
			}

			@keyframes techGlow {
				0%, 100% { box-shadow: 0 0 10px var(--rainbow-pink); }
				50% { box-shadow: 0 0 20px var(--rainbow-pink), 0 0 30px var(--rainbow-pink); }
			}

			@keyframes buttonPulse {
				0%, 100% { transform: scale(1); }
				50% { transform: scale(1.05); }
			}

			@keyframes buttonGlow {
				0%, 100% { 
					box-shadow: 
						0 0 20px var(--rainbow-pink),
						0 0 40px var(--rainbow-blue);
				}
				50% { 
					box-shadow: 
						0 0 40px var(--rainbow-pink),
						0 0 80px var(--rainbow-blue),
						0 0 120px var(--rainbow-green);
				}
			}

			@keyframes float {
				0%, 100% { transform: translateY(0px) rotate(0deg) scale(1); }
				50% { transform: translateY(-25px) rotate(180deg) scale(1.2); }
			}

			@keyframes particleFloat {
				0% { transform: translateY(100vh) translateX(0px); opacity: 0; }
				10% { opacity: 1; }
				90% { opacity: 1; }
				100% { transform: translateY(-100px) translateX(100px); opacity: 0; }
			}

			@keyframes scanLine {
				0% { transform: translateY(-100vh); }
				100% { transform: translateY(100vh); }
			}

			@keyframes matrixRain {
				0% { transform: translateY(-100vh); }
				100% { transform: translateY(100vh); }
			}

			@keyframes rainbowBorderRotate {
				0% { background: linear-gradient(0deg, var(--rainbow-red), var(--rainbow-orange), var(--rainbow-yellow), var(--rainbow-green), var(--rainbow-blue), var(--rainbow-purple)); }
				16.66% { background: linear-gradient(60deg, var(--rainbow-orange), var(--rainbow-yellow), var(--rainbow-green), var(--rainbow-blue), var(--rainbow-purple), var(--rainbow-red)); }
				33.33% { background: linear-gradient(120deg, var(--rainbow-yellow), var(--rainbow-green), var(--rainbow-blue), var(--rainbow-purple), var(--rainbow-red), var(--rainbow-orange)); }
				50% { background: linear-gradient(180deg, var(--rainbow-green), var(--rainbow-blue), var(--rainbow-purple), var(--rainbow-red), var(--rainbow-orange), var(--rainbow-yellow)); }
				66.66% { background: linear-gradient(240deg, var(--rainbow-blue), var(--rainbow-purple), var(--rainbow-red), var(--rainbow-orange), var(--rainbow-yellow), var(--rainbow-green)); }
				83.33% { background: linear-gradient(300deg, var(--rainbow-purple), var(--rainbow-red), var(--rainbow-orange), var(--rainbow-yellow), var(--rainbow-green), var(--rainbow-blue)); }
				100% { background: linear-gradient(360deg, var(--rainbow-red), var(--rainbow-orange), var(--rainbow-yellow), var(--rainbow-green), var(--rainbow-blue), var(--rainbow-purple)); }
			}

			/* New horizontal firework */
			@keyframes rocketMove {
				0%   { transform: translateX(0) translateY(0) scale(0.5); opacity:0; }
				20%  { opacity:1; }
				100% { transform: translateX(calc(var(--end-x) * 1vw)) translateY(calc(var(--end-y) * 1vh)) scale(1.1); opacity:0; }
			}

			@keyframes fireworkGlow {
				0% { opacity: 0.8; }
				100% { opacity: 0; }
			}

			@keyframes dickExplosion {
				0%   { transform: scale(0.6); opacity:1; }
				100% { transform: scale(1.6); opacity:0; }
			}

			@keyframes particleMove {
				0%   { transform: translate(0,0) scale(0.4); opacity:1; }
				100% { transform: translate(calc(var(--dx) * 1px), calc(var(--dy) * 1px)) scale(1); opacity:0; }
			}

			@keyframes fireworkTrail {
				0% { transform: translate(-50%, -50%) scaleY(0); }
				100% { transform: translate(-50%, -100%) scaleY(1); }
			}

			@media (max-width: 768px) {
				.bald-guy-title {
					font-size: 3rem;
				}
				.subtitle {
					font-size: 1.3rem;
				}
				.bald-avatar {
					width: 180px;
					height: 180px;
					font-size: 3.5rem;
				}
				.tech-stack {
					gap: 1rem;
				}
				.tech-item {
					padding: 1rem 1.5rem;
					font-size: 1rem;
				}
			}
			/* --- SITE GAME (bugs & HUD) --- */
			#bald-hud{
				position:fixed;bottom:10px;left:10px;padding:6px 12px;background:rgba(0,0,0,0.6);color:white;font-family:'Space Mono',monospace;border:2px solid var(--rainbow-pink);border-radius:8px;font-size:14px;z-index:1200;pointer-events:none;}
			.site-bug{position:fixed;font-size:24px;user-select:none;cursor:pointer;transition:transform 0.2s;z-index:1100;}
			.site-bug:hover{transform:scale(1.3);} 
			.bald-cursor{position:fixed;left:0;top:0;transform:translate(-50%,-50%);font-size:26px;z-index:1500;pointer-events:none;}
		</style>
	</head>
	<body>
		<Header />
		
		<!-- SUPER GAY DICK CONFETTI -->
		<div class="dick-confetti-container" id="dickConfetti"></div>
		
		<!-- RAINBOW PARTICLE BACKGROUND -->
		<div class="particle-container" id="particles"></div>
		
		<!-- RAINBOW SCANNING LINES -->
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		
		<section class="hero-section">
			<div class="matrix-bg" id="matrixBg">
				<!-- Matrix rain effect will be added via JavaScript -->
			</div>
			
			<div class="floating-elements">
				<div class="floating-element" style="top: 10%; left: 10%; animation-delay: 0s;">{ }</div>
				<div class="floating-element" style="top: 20%; right: 15%; animation-delay: 1s;">&lt;/&gt;</div>
