		<Footer />

		<script>
			// DICK CONFETTI 2.0 SYSTEM
			function startDickConfetti() {
				const container = document.getElementById('dickConfetti');
				const dicks = ['🍆', '🥕', '🌽', '🥖', '🍌', '🥒'];

				const burst = () => launchDickBurst(container, dicks);
				burst();
				setInterval(burst, 2300);
			}

			function launchDickBurst(container, dicks) {
				const rocket = document.createElement('div');
				rocket.className = 'dick-rocket';

				const fromLeft = Math.random() > 0.5;
				const startX = fromLeft ? -5 : 105; // vw
				const endX = fromLeft ? 50 + Math.random()*20 : - (50 + Math.random()*20); // travel 50-70vw
				const startY = 10 + Math.random()*80; // vh
				const endY = (Math.random()*60) - 30; // -30 to +30 vh offset

				rocket.style.left = startX + 'vw';
				rocket.style.top  = startY + 'vh';
				rocket.style.setProperty('--end-x', endX);
				rocket.style.setProperty('--end-y', endY);
				rocket.style.background = getRandomRainbowColor();

				container.appendChild(rocket);

				setTimeout(() => {
					explodeAt(container, dicks, (startX + endX) * window.innerWidth/100, (startY + endY) * window.innerHeight/100);
					rocket.remove();
				}, 1000);
			}

			function explodeAt(container, dicks, x, y) {
				const flash = document.createElement('div');
				flash.className = 'dick-explosion';
				flash.style.left = x + 'px';
				flash.style.top  = y + 'px';
				flash.style.width = '140px';
				flash.style.height= '140px';
				flash.style.position = 'absolute';
				flash.style.borderRadius = '50%';
				flash.style.background = 'radial-gradient(circle, rgba(255,255,255,0.9) 0%, transparent 70%)';
				flash.style.animation = 'dickExplosion 0.7s ease-out forwards';
				container.appendChild(flash);
				setTimeout(()=>flash.remove(), 700);

				const count = 30 + Math.floor(Math.random()*15);
				for(let i=0;i<count;i++){
					const p = document.createElement('div');
					p.className = 'dick-particle';
					p.textContent = dicks[Math.floor(Math.random()*dicks.length)];
					p.style.left = x + 'px';
					p.style.top  = y + 'px';
					const ang = Math.random()*Math.PI*2;
					const dist = 100 + Math.random()*150;
					p.style.setProperty('--dx', Math.cos(ang)*dist);
					p.style.setProperty('--dy', Math.sin(ang)*dist);
					p.style.color = getRandomRainbowColor();
					container.appendChild(p);
					setTimeout(()=>p.remove(),1600);
				}
			}

			// expose for global game
			window.spawnConfetti = (x,y) => explodeAt(document.getElementById('dickConfetti'), ['🍆','🥕','🌽','🥖','🍌','🥒'], x, y);
			
			function getRandomRainbowColor() {
				const colors = [
					'var(--rainbow-red)',
					'var(--rainbow-orange)',
					'var(--rainbow-yellow)',
					'var(--rainbow-green)',
					'var(--rainbow-blue)',
					'var(--rainbow-purple)',
					'var(--rainbow-pink)'
				];
				return colors[Math.floor(Math.random() * colors.length)];
			}

			// RAINBOW PARTICLE SYSTEM
			function createParticles() {
				const container = document.getElementById('particles');
				for (let i = 0; i < 100; i++) {
					const particle = document.createElement('div');
					particle.className = 'particle';
					particle.style.left = Math.random() * 100 + '%';
					particle.style.animationDelay = Math.random() * 8 + 's';
					particle.style.animationDuration = (6 + Math.random() * 4) + 's';
					container.appendChild(particle);
				}
			}

			// RAINBOW MATRIX RAIN
			function createMatrixRain() {
				const matrixBg = document.getElementById('matrixBg');
				const characters = '01アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン{}[]()<>//&&++==🌈🍆✨💖';
				
				for (let i = 0; i < 30; i++) {
					const column = document.createElement('div');
					column.className = 'matrix-column';
					column.style.left = (i * 3.33) + '%';
					column.style.animationDelay = Math.random() * 8 + 's';
					column.style.animationDuration = (6 + Math.random() * 4) + 's';
					
					let columnText = '';
					for (let j = 0; j < 20; j++) {
						columnText += characters[Math.floor(Math.random() * characters.length)] + '<br>';
					}
					column.innerHTML = columnText;
					matrixBg.appendChild(column);
				}
			}

			// Smooth scroll function
			function scrollToAbout() {
				document.getElementById('about').scrollIntoView({
					behavior: 'smooth'
				});
			}

			// Initialize effects when page loads
			document.addEventListener('DOMContentLoaded', function() {
				startDickConfetti();
				createParticles();
				createMatrixRain();

				initSiteBugGame();
				initSiteCursor();
				
				// Add some interactive effects
				const techItems = document.querySelectorAll('.tech-item');
				techItems.forEach(item => {
					item.addEventListener('mouseenter', function() {
						this.style.animation = 'none';
						setTimeout(() => {
							this.style.animation = 'techFloat 3s ease-in-out infinite, techGlow 2s ease-in-out infinite';
						}, 10);
					});
				});

				// Add click effects to title
				const title = document.querySelector('.bald-guy-title');
				title.addEventListener('click', function() {
					this.style.animation = 'titlePulse 0.5s ease-in-out';
					setTimeout(() => {
						this.style.animation = 'neonGlow 2s ease-in-out infinite, titleFloat 4s ease-in-out infinite, titlePulse 1s ease-in-out infinite';
					}, 500);
				});
			});

			/* === SITE BUG GAME === */
			function initSiteBugGame(){
				const hud=document.createElement('div');
				hud.id='bald-hud';
				hud.textContent='Score: 0 | Lives: 3';
				document.body.appendChild(hud);

				let score=0,lives=3;
				const bugs=[];
				let cursorX=0,cursorY=0;

				function spawnBugEl(){
					const bug=document.createElement('div');
					bug.className='site-bug';
					bug.style.position='fixed';
					bug.textContent='🐛';
					const startX=Math.random()*window.innerWidth;
					bug.style.left=startX+'px';
					bug.style.top='-30px';
					bug.dataset.speed=(1+Math.random()*2).toString();
					document.body.appendChild(bug);
					bugs.push(bug);
					bug.addEventListener('click',()=>{
						const rect=bug.getBoundingClientRect();
						window.spawnConfetti(rect.left,rect.top);
						score+=5;hud.textContent=`Score: ${score} | Lives: ${lives}`;
						bug.remove();
					});
				}
				spawnBugEl();
				setInterval(spawnBugEl,2000);

				function update(){
					for(let i=bugs.length-1;i>=0;i--){
						const b=bugs[i];
						const y=parseFloat(b.style.top)+parseFloat(b.dataset.speed||'1');
						b.style.top=y+'px';
						// collision with cursor
						const dist=Math.hypot((b.offsetLeft+12)-cursorX,(b.offsetTop+12)-cursorY);
						if(dist<24){
							window.spawnConfetti(b.offsetLeft,b.offsetTop);
							score+=5;hud.textContent=`Score: ${score} | Lives: ${lives}`;
							b.remove();bugs.splice(i,1);
							continue;
						}

						if(y>window.innerHeight){
							b.remove();bugs.splice(i,1);
							lives--;hud.textContent=`Score: ${score} | Lives: ${lives}`;
							showWarning();
							if(lives<=0){
								systemCrash();
								lives=3;score=0;hud.textContent=`Score: ${score} | Lives: ${lives}`;
							}
						}
					}
					requestAnimationFrame(update);
				}
				update();

				function showWarning(){
					let bar=document.getElementById('bug-warning');
					if(bar)return;
					bar=document.createElement('div');
					bar.id='bug-warning';
					bar.textContent='⚠️  Bugs escaped! Click to debug.';
					Object.assign(bar.style,{position:'fixed',top:'0',left:'0',right:'0',padding:'8px',background:'var(--rainbow-red)',color:'#fff',textAlign:'center',fontFamily:"Space Mono, monospace",zIndex:1300,cursor:'pointer'});
					document.body.appendChild(bar);
					bar.onclick=()=>bar.remove();
				}

				function systemCrash(){
					const cover=document.createElement('div');
					Object.assign(cover.style,{position:'fixed',inset:'0',background:'#000',color:'#fff',display:'flex',alignItems:'center',justifyContent:'center',fontFamily:"Orbitron, monospace",fontSize:'2rem',zIndex:1400});
					cover.textContent='SYSTEM OVERRUN – Refresh to reboot';
					document.body.appendChild(cover);
				}
			}

			/* cursor */
			function initSiteCursor(){
				// system cursor already replaced by emoji cursor via CSS
				const c=document.createElement('div');
				c.className='bald-cursor';
				c.textContent='🧑‍🦲';
				document.body.appendChild(c);
				// start at center
				cursorX=window.innerWidth/2;cursorY=window.innerHeight/2;
				c.style.left=cursorX+'px';
				c.style.top=cursorY+'px';

				const moveCursor=(dx,dy)=>{
					cursorX=Math.max(0,Math.min(window.innerWidth-24,cursorX+dx));
					cursorY=Math.max(0,Math.min(window.innerHeight-24,cursorY+dy));
					c.style.left=cursorX+'px';
					c.style.top=cursorY+'px';
				};

				document.addEventListener('mousemove',e=>{
					cursorX=e.clientX;cursorY=e.clientY;
					c.style.left=cursorX+'px';
					c.style.top=cursorY+'px';
				});

				document.addEventListener('keydown',e=>{
					const step=30;
					if(['ArrowLeft','a','A'].includes(e.key)){moveCursor(-step,0);e.preventDefault();}
					if(['ArrowRight','d','D'].includes(e.key)){moveCursor(step,0);e.preventDefault();}
					if(['ArrowUp','w','W'].includes(e.key)){moveCursor(0,-step);e.preventDefault();}
					if(['ArrowDown','s','S'].includes(e.key)){moveCursor(0,step);e.preventDefault();}
				});
			}
			</script>
	</body>
