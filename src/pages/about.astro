---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About – Esben Fogh" description="Learn more about Esben Fogh, Diploma Engineer in Software Technology and RPA Developer" />
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap');
			
			:root {
				--rainbow-red: #ff0000;
				--rainbow-orange: #ff8000;
				--rainbow-yellow: #ffff00;
				--rainbow-green: #00ff00;
				--rainbow-blue: #0080ff;
				--rainbow-purple: #8000ff;
				--rainbow-pink: #ff0080;
				--dark-bg: #0a0a0a;
			}

			body {
				background: var(--dark-bg);
				color: white;
				font-family: 'Space Mono', monospace;
				margin: 0;
				overflow-x: hidden;
			}

			/* EPIC DICK FIREWORKS */
			.dick-confetti-container {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				pointer-events: none;
				z-index: 100;
				overflow: hidden;
			}

			.dick-firework {
				position: absolute;
				width: 10px;
				height: 10px;
				border-radius: 50%;
				animation: dickFireworkLaunch 3s ease-out forwards;
			}

			.dick-firework::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: currentColor;
				border-radius: 50%;
				animation: fireworkGlow 0.5s ease-out infinite;
			}

			.dick-explosion {
				position: absolute;
				animation: dickExplosion 2s ease-out forwards;
			}

			.dick-particle {
				position: absolute;
				font-size: 1.2rem;
				animation: dickParticleFly 1.5s ease-out forwards;
				opacity: 0;
			}

			.dick-particle:nth-child(odd) { color: var(--rainbow-pink); }
			.dick-particle:nth-child(even) { color: var(--rainbow-blue); }
			.dick-particle:nth-child(3n) { color: var(--rainbow-green); }
			.dick-particle:nth-child(4n) { color: var(--rainbow-yellow); }
			.dick-particle:nth-child(5n) { color: var(--rainbow-purple); }
			.dick-particle:nth-child(6n) { color: var(--rainbow-orange); }

			/* FIREWORK TRAIL EFFECT */
			.dick-firework::after {
				content: '';
				position: absolute;
				top: 50%;
				left: 50%;
				width: 2px;
				height: 20px;
				background: linear-gradient(to bottom, currentColor, transparent);
				transform: translate(-50%, -50%);
				animation: fireworkTrail 0.5s ease-out infinite;
			}

			/* RAINBOW PARTICLE BACKGROUND */
			.particle-container {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				z-index: 1;
				pointer-events: none;
			}

			.particle {
				position: absolute;
				width: 4px;
				height: 4px;
				border-radius: 50%;
				animation: particleFloat 8s linear infinite;
			}

			.particle:nth-child(6n+1) { background: var(--rainbow-red); animation-duration: 6s; }
			.particle:nth-child(6n+2) { background: var(--rainbow-orange); animation-duration: 7s; }
			.particle:nth-child(6n+3) { background: var(--rainbow-yellow); animation-duration: 8s; }
			.particle:nth-child(6n+4) { background: var(--rainbow-green); animation-duration: 9s; }
			.particle:nth-child(6n+5) { background: var(--rainbow-blue); animation-duration: 10s; }
			.particle:nth-child(6n+6) { background: var(--rainbow-purple); animation-duration: 11s; }

			/* RAINBOW SCANNING LINES */
			.scan-line {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 2px;
				z-index: 2;
				animation: scanLine 3s linear infinite;
			}

			.scan-line:nth-child(1) {
				background: linear-gradient(90deg, transparent, var(--rainbow-red), transparent);
			}

			.scan-line:nth-child(2) {
				animation-delay: 1s;
				background: linear-gradient(90deg, transparent, var(--rainbow-orange), transparent);
			}

			.scan-line:nth-child(3) {
				animation-delay: 2s;
				background: linear-gradient(90deg, transparent, var(--rainbow-yellow), transparent);
			}

			.scan-line:nth-child(4) {
				animation-delay: 3s;
				background: linear-gradient(90deg, transparent, var(--rainbow-green), transparent);
			}

			.scan-line:nth-child(5) {
				animation-delay: 4s;
				background: linear-gradient(90deg, transparent, var(--rainbow-blue), transparent);
			}

			.scan-line:nth-child(6) {
				animation-delay: 5s;
				background: linear-gradient(90deg, transparent, var(--rainbow-purple), transparent);
			}

			.about-section {
				min-height: 100vh;
				padding: 8rem 2rem 4rem;
				position: relative;
				background: linear-gradient(45deg, #000000, #1a1a1a, #000000);
				overflow: hidden;
				z-index: 10;
			}

			/* RAINBOW HOLOGRAPHIC GRID */
			.holographic-grid {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				opacity: 0.2;
				z-index: 1;
				background-image: 
					linear-gradient(rgba(255, 0, 255, 0.1) 1px, transparent 1px),
					linear-gradient(90deg, rgba(255, 0, 255, 0.1) 1px, transparent 1px);
				background-size: 50px 50px;
				animation: gridPulse 4s ease-in-out infinite;
			}

			.about-content {
				max-width: 1200px;
				margin: 0 auto;
				position: relative;
				z-index: 20;
			}

			.about-title {
				text-align: center;
				font-family: 'Orbitron', monospace;
				font-size: 4rem;
				font-weight: 900;
				margin-bottom: 3rem;
				background: linear-gradient(45deg, var(--rainbow-red), var(--rainbow-orange), var(--rainbow-yellow), var(--rainbow-green), var(--rainbow-blue), var(--rainbow-purple));
				background-size: 300% 300%;
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				animation: neonGlow 2s ease-in-out infinite, titleFloat 4s ease-in-out infinite;
				text-shadow: 
					0 0 20px var(--rainbow-pink),
					0 0 40px var(--rainbow-pink),
					0 0 60px var(--rainbow-pink);
			}

			.about-subtitle {
				text-align: center;
				font-size: 1.5rem;
				color: var(--rainbow-yellow);
				margin-bottom: 4rem;
				animation: subtitlePulse 2s ease-in-out infinite;
				text-shadow: 0 0 15px var(--rainbow-yellow);
			}

			.about-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
				gap: 3rem;
				margin-bottom: 4rem;
			}

			.about-card {
				background: rgba(255, 0, 255, 0.1);
				padding: 2.5rem;
				border-radius: 20px;
				border: 3px solid var(--rainbow-pink);
				position: relative;
				overflow: hidden;
				animation: cardFloat 5s ease-in-out infinite;
				transition: all 0.3s ease;
				text-align: center;
			}

			.about-card::before {
				content: '';
				position: absolute;
				top: 0;
				left: -100%;
				width: 100%;
				height: 100%;
				background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
				transition: left 0.5s ease;
			}

			.about-card:hover {
				transform: scale(1.05) rotate(2deg);
				box-shadow: 
					0 0 30px var(--rainbow-pink),
					0 0 60px var(--rainbow-blue);
				border-color: var(--rainbow-blue);
			}

			.about-card:hover::before {
				left: 100%;
			}

			.card-icon {
				font-size: 4rem;
				margin-bottom: 1.5rem;
				animation: iconRotate 10s linear infinite;
				filter: drop-shadow(0 0 15px var(--rainbow-pink));
			}

			.card-title {
				font-family: 'Orbitron', monospace;
				font-size: 1.8rem;
				color: var(--rainbow-pink);
				margin-bottom: 1rem;
				text-shadow: 0 0 10px var(--rainbow-pink);
			}

			.card-description {
				font-size: 1.1rem;
				line-height: 1.6;
				color: white;
			}

			.skills-section {
				margin: 4rem 0;
			}

			.skills-title {
				text-align: center;
				font-family: 'Orbitron', monospace;
				font-size: 2.5rem;
				color: var(--rainbow-blue);
				margin-bottom: 3rem;
				text-shadow: 0 0 15px var(--rainbow-blue);
				animation: titleGlow 3s ease-in-out infinite;
			}

			.skills-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 2rem;
			}

			.skill-card {
				background: rgba(0, 255, 255, 0.1);
				padding: 2rem;
				border-radius: 15px;
				border: 2px solid var(--rainbow-blue);
				text-align: center;
				animation: skillFloat 4s ease-in-out infinite;
				transition: all 0.3s ease;
				position: relative;
				overflow: hidden;
			}

			.skill-card::before {
				content: '';
				position: absolute;
				top: 0;
				left: -100%;
				width: 100%;
				height: 100%;
				background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.2), transparent);
				transition: left 0.5s ease;
			}

			.skill-card:hover {
				transform: scale(1.1) rotate(5deg);
				box-shadow: 
					0 0 25px var(--rainbow-blue),
					0 0 50px var(--rainbow-green);
				border-color: var(--rainbow-green);
			}

			.skill-card:hover::before {
				left: 100%;
			}

			.skill-name {
				font-family: 'Orbitron', monospace;
				font-size: 1.3rem;
				color: var(--rainbow-blue);
				margin-bottom: 1rem;
				text-shadow: 0 0 10px var(--rainbow-blue);
			}

			.skill-level {
				width: 100%;
				height: 8px;
				background: rgba(255, 255, 255, 0.1);
				border-radius: 4px;
				overflow: hidden;
				position: relative;
			}

			.skill-progress {
				height: 100%;
				background: linear-gradient(90deg, var(--rainbow-blue), var(--rainbow-green));
				border-radius: 4px;
				animation: progressGlow 2s ease-in-out infinite;
			}

			.timeline-section {
				margin: 4rem 0;
			}

			.timeline-title {
				text-align: center;
				font-family: 'Orbitron', monospace;
				font-size: 2.5rem;
				color: var(--rainbow-green);
				margin-bottom: 3rem;
				text-shadow: 0 0 15px var(--rainbow-green);
				animation: titleGlow 3s ease-in-out infinite;
			}

			.timeline {
				position: relative;
				max-width: 800px;
				margin: 0 auto;
			}

			.timeline::before {
				content: '';
				position: absolute;
				left: 50%;
				top: 0;
				bottom: 0;
				width: 4px;
				background: linear-gradient(to bottom, var(--rainbow-green), var(--rainbow-blue), var(--rainbow-purple));
				transform: translateX(-50%);
				animation: timelineGlow 3s ease-in-out infinite;
			}

			.timeline-item {
				position: relative;
				margin: 3rem 0;
				width: 45%;
				animation: timelineFloat 6s ease-in-out infinite;
			}

			.timeline-item:nth-child(odd) {
				left: 0;
				text-align: right;
			}

			.timeline-item:nth-child(even) {
				left: 55%;
				text-align: left;
			}

			.timeline-content {
				background: rgba(0, 255, 0, 0.1);
				padding: 2rem;
				border-radius: 15px;
				border: 2px solid var(--rainbow-green);
				position: relative;
				transition: all 0.3s ease;
			}

			.timeline-content::before {
				content: '';
				position: absolute;
				top: 50%;
				width: 20px;
				height: 20px;
				background: var(--rainbow-green);
				border-radius: 50%;
				transform: translateY(-50%);
				box-shadow: 0 0 15px var(--rainbow-green);
				animation: timelineDot 2s ease-in-out infinite;
			}

			.timeline-item:nth-child(odd) .timeline-content::before {
				right: -60px;
			}

			.timeline-item:nth-child(even) .timeline-content::before {
				left: -60px;
			}

			.timeline-content:hover {
				transform: scale(1.05);
				box-shadow: 
					0 0 25px var(--rainbow-green),
					0 0 50px var(--rainbow-blue);
				border-color: var(--rainbow-blue);
			}

			.timeline-year {
				font-family: 'Orbitron', monospace;
				font-size: 1.2rem;
				color: var(--rainbow-green);
				margin-bottom: 0.5rem;
				text-shadow: 0 0 10px var(--rainbow-green);
			}

			.timeline-title {
				font-size: 1.3rem;
				color: white;
				margin-bottom: 0.5rem;
			}

			.timeline-description {
				font-size: 1rem;
				color: #ccc;
			}

			/* EPIC DICK FIREWORKS ANIMATIONS */
			@keyframes dickFireworkLaunch {
				0% { transform: translateY(0) translateX(0) scale(0.1); opacity: 0; }
				50% { opacity: 1; }
				100% { transform: translateY(-100vh) translateX(calc(var(--launch-x) * 100%)) scale(1); opacity: 0; }
			}

			@keyframes fireworkGlow {
				0% { opacity: 0.8; }
				100% { opacity: 0; }
			}

			@keyframes dickExplosion {
				0% { transform: scale(1); opacity: 1; }
				100% { transform: scale(1.5); opacity: 0; }
			}

			@keyframes dickParticleFly {
				0% { transform: translateY(0) translateX(0) scale(0.5); opacity: 0; }
				50% { opacity: 1; }
				100% { transform: translateY(-100px) translateX(calc(var(--particle-x) * 100%)) scale(1); opacity: 0; }
			}

			@keyframes fireworkTrail {
				0% { transform: translate(-50%, -50%) scaleY(0); }
				100% { transform: translate(-50%, -100%) scaleY(1); }
			}

			@keyframes neonGlow {
				0%, 100% { background-position: 0% 50%; }
				50% { background-position: 100% 50%; }
			}

			@keyframes titleFloat {
				0%, 100% { transform: translateY(0px) rotate(0deg); }
				50% { transform: translateY(-10px) rotate(1deg); }
			}

			@keyframes subtitlePulse {
				0%, 100% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.8; transform: scale(1.02); }
			}

			@keyframes particleFloat {
				0% { transform: translateY(100vh) translateX(0px); opacity: 0; }
				10% { opacity: 1; }
				90% { opacity: 1; }
				100% { transform: translateY(-100px) translateX(100px); opacity: 0; }
			}

			@keyframes scanLine {
				0% { transform: translateY(-100vh); }
				100% { transform: translateY(100vh); }
			}

			@keyframes gridPulse {
				0%, 100% { opacity: 0.2; }
				50% { opacity: 0.4; }
			}

			@keyframes cardFloat {
				0%, 100% { transform: translateY(0px) rotate(0deg); }
				50% { transform: translateY(-10px) rotate(1deg); }
			}

			@keyframes iconRotate {
				from { transform: rotate(0deg); }
				to { transform: rotate(360deg); }
			}

			@keyframes titleGlow {
				0%, 100% { text-shadow: 0 0 15px currentColor; }
				50% { text-shadow: 0 0 25px currentColor, 0 0 35px currentColor; }
			}

			@keyframes skillFloat {
				0%, 100% { transform: translateY(0px) rotate(0deg); }
				50% { transform: translateY(-8px) rotate(2deg); }
			}

			@keyframes progressGlow {
				0%, 100% { box-shadow: 0 0 10px var(--rainbow-blue); }
				50% { box-shadow: 0 0 20px var(--rainbow-blue), 0 0 30px var(--rainbow-green); }
			}

			@keyframes timelineGlow {
				0%, 100% { box-shadow: 0 0 10px var(--rainbow-green); }
				50% { box-shadow: 0 0 20px var(--rainbow-green), 0 0 30px var(--rainbow-blue); }
			}

			@keyframes timelineFloat {
				0%, 100% { transform: translateY(0px); }
				50% { transform: translateY(-5px); }
			}

			@keyframes timelineDot {
				0%, 100% { transform: translateY(-50%) scale(1); }
				50% { transform: translateY(-50%) scale(1.2); }
			}

			@media (max-width: 768px) {
				.about-title {
					font-size: 2.5rem;
				}

				.about-subtitle {
					font-size: 1.2rem;
				}

				.about-grid {
					grid-template-columns: 1fr;
					gap: 2rem;
				}

				.about-card {
					padding: 2rem;
				}

				.card-icon {
					font-size: 3rem;
				}

				.skills-grid {
					grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
					gap: 1.5rem;
				}

				.timeline::before {
					left: 20px;
				}

				.timeline-item {
					width: 100%;
					left: 0 !important;
					text-align: left !important;
					padding-left: 60px;
				}

				.timeline-item .timeline-content::before {
					left: -40px !important;
				}
			}
		</style>
	</head>
	<body>
		<Header title="About" />
		
		<!-- SUPER GAY DICK CONFETTI -->
		<div class="dick-confetti-container" id="dickConfetti"></div>
		
		<!-- RAINBOW PARTICLE BACKGROUND -->
		<div class="particle-container" id="particles"></div>
		
		<!-- RAINBOW SCANNING LINES -->
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		
		<section class="about-section">
			<div class="holographic-grid"></div>
			
			<div class="about-content">
				<h1 class="about-title">About Esben Fogh</h1>
				<p class="about-subtitle">Diplomingeniør i Software Teknologi · RPA Developer @ FL JORD · Esbjerg, Denmark</p>
				
				<div class="about-grid">
					<div class="about-card">
						<div class="card-icon">💻</div>
						<h3 class="card-title">RPA Developer – FL JORD</h3>
						<p class="card-description">
							Apr 2025 – Present (part-time).<br/>
							• Automates administrative workflows in construction projects<br/>
							• Designs SharePoint structures for order and case handling<br/>
							• Develops Power Automate flows to retrieve business-critical documents
						</p>
					</div>

					<div class="about-card">
						<div class="card-icon">🎮</div>
						<h3 class="card-title">Software Developer – Acrypt</h3>
						<p class="card-description">
							Jan – Jun 2023 (internship). Sole developer of an AR mobile game in Unity/C#.<br/>
							Planned, organised and shipped independently – from gameplay loop to Android release build.
						</p>
					</div>

					<div class="about-card">
						<div class="card-icon">🎓</div>
						<h3 class="card-title">Diploma Engineer, Software Technology</h3>
						<p class="card-description">
							VIA University College, 2020-2023.<br/>
							Project-oriented programme emphasising practical application of multiple languages and methodologies.
						</p>
					</div>
				</div>
				
				<div class="skills-section">
					<h2 class="skills-title">Core Skills</h2>
					<div class="skills-grid">
						<div class="skill-card"><div class="skill-name">RPA & Power Automate</div><div class="skill-level"><div class="skill-progress" style="width:95%;"></div></div></div>
						<div class="skill-card"><div class="skill-name">SharePoint Automation</div><div class="skill-level"><div class="skill-progress" style="width:90%;"></div></div></div>
						<div class="skill-card"><div class="skill-name">C# / Unity (AR)</div><div class="skill-level"><div class="skill-progress" style="width:85%;"></div></div></div>
						<div class="skill-card"><div class="skill-name">JavaScript / TypeScript</div><div class="skill-level"><div class="skill-progress" style="width:80%;"></div></div></div>
						<div class="skill-card"><div class="skill-name">Android Development</div><div class="skill-level"><div class="skill-progress" style="width:80%;"></div></div></div>
						<div class="skill-card"><div class="skill-name">CSS & Responsive Web</div><div class="skill-level"><div class="skill-progress" style="width:80%;"></div></div></div>
						<div class="skill-card"><div class="skill-name">Project Management</div><div class="skill-level"><div class="skill-progress" style="width:75%;"></div></div></div>
					</div>
				</div>
				
				<div class="timeline-section">
					<h2 class="timeline-title">Journey</h2>
					<div class="timeline">
						<div class="timeline-item">
							<div class="timeline-content">
								<div class="timeline-year">Apr 2025 – Present</div>
								<h3 class="timeline-title">FL JORD · RPA Developer</h3>
								<p class="timeline-description">Building Power Automate flows and SharePoint structures to streamline construction-sector administration.</p>
							</div>
						</div>

						<div class="timeline-item">
							<div class="timeline-content">
								<div class="timeline-year">Jan – Jun 2023</div>
								<h3 class="timeline-title">Acrypt · AR Game Dev Intern</h3>
								<p class="timeline-description">Owned a Unity/C# codebase; shipped Android builds; honed self-driven workflows.</p>
							</div>
						</div>

						<div class="timeline-item">
							<div class="timeline-content">
								<div class="timeline-year">2020 – 2023</div>
								<h3 class="timeline-title">VIA University College</h3>
								<p class="timeline-description">Diploma Engineer studies in Software Technology with a strong project-based focus.</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<Footer />

		<script>
			// EPIC DICK FIREWORKS SYSTEM
			function createDickFireworks() {
				const container = document.getElementById('dickConfetti');
				const dicks = ['🍆', '🥕', '🌽', '🥖', '🍌', '🥒'];
				
				// Launch fireworks from sides
				setInterval(() => {
					launchDickFirework(container, dicks);
				}, 2000);
				
				// Launch initial fireworks
				for (let i = 0; i < 5; i++) {
					setTimeout(() => {
						launchDickFirework(container, dicks);
					}, i * 500);
				}
			}
			
			function launchDickFirework(container, dicks) {
				// Create firework rocket
				const firework = document.createElement('div');
				firework.className = 'dick-firework';
				
				// Random launch position from sides
				const isFromLeft = Math.random() > 0.5;
				const launchX = isFromLeft ? -0.1 : 1.1;
				const targetX = Math.random() * 0.8 + 0.1; // Target in middle area
				const targetY = Math.random() * 0.6 + 0.2; // Target in upper area
				
				firework.style.left = (launchX * 100) + '%';
				firework.style.bottom = '0%';
				firework.style.setProperty('--launch-x', (targetX - launchX).toString());
				firework.style.color = getRandomRainbowColor();
				
				container.appendChild(firework);
				
				// Explode after launch animation
				setTimeout(() => {
					explodeDickFirework(container, dicks, targetX * window.innerWidth, (1 - targetY) * window.innerHeight);
					firework.remove();
				}, 3000);
			}
			
			function explodeDickFirework(container, dicks, x, y) {
				// Create explosion effect
				const explosion = document.createElement('div');
				explosion.className = 'dick-explosion';
				explosion.style.left = x + 'px';
				explosion.style.top = y + 'px';
				explosion.style.width = '100px';
				explosion.style.height = '100px';
				explosion.style.background = 'radial-gradient(circle, rgba(255,255,255,0.8) 0%, transparent 70%)';
				explosion.style.borderRadius = '50%';
				
				container.appendChild(explosion);
				
				// Create dick particles
				const particleCount = 15 + Math.floor(Math.random() * 10);
				for (let i = 0; i < particleCount; i++) {
					const particle = document.createElement('div');
					particle.className = 'dick-particle';
					particle.textContent = dicks[Math.floor(Math.random() * dicks.length)];
					particle.style.left = x + 'px';
					particle.style.top = y + 'px';
					
					// Random direction for each particle
					const angle = (i / particleCount) * 2 * Math.PI;
					const distance = 100 + Math.random() * 150;
					const particleX = Math.cos(angle) * distance;
					const particleY = Math.sin(angle) * distance;
					
					particle.style.setProperty('--particle-x', (particleX / window.innerWidth).toString());
					particle.style.setProperty('--particle-y', (particleY / window.innerHeight).toString());
					particle.style.animationDelay = (Math.random() * 0.5) + 's';
					
					container.appendChild(particle);
					
					// Remove particle after animation
					setTimeout(() => {
						particle.remove();
					}, 2000);
				}
				
				// Remove explosion after animation
				setTimeout(() => {
					explosion.remove();
				}, 2000);
			}
			
			function getRandomRainbowColor() {
				const colors = [
					'var(--rainbow-red)',
					'var(--rainbow-orange)',
					'var(--rainbow-yellow)',
					'var(--rainbow-green)',
					'var(--rainbow-blue)',
					'var(--rainbow-purple)',
					'var(--rainbow-pink)'
				];
				return colors[Math.floor(Math.random() * colors.length)];
			}

			// RAINBOW PARTICLE SYSTEM
			function createParticles() {
				const container = document.getElementById('particles');
				for (let i = 0; i < 100; i++) {
					const particle = document.createElement('div');
					particle.className = 'particle';
					particle.style.left = Math.random() * 100 + '%';
					particle.style.animationDelay = Math.random() * 8 + 's';
					particle.style.animationDuration = (6 + Math.random() * 4) + 's';
					container.appendChild(particle);
				}
			}

			// Initialize effects when page loads
			document.addEventListener('DOMContentLoaded', function() {
				createDickFireworks();
				createParticles();
				
				// Add interactive effects
				const cards = document.querySelectorAll('.about-card, .skill-card, .timeline-content');
				cards.forEach(card => {
					card.addEventListener('mouseenter', function() {
						this.style.animation = 'none';
						setTimeout(() => {
							this.style.animation = '';
						}, 10);
					});
				});

				// Add click effects to title
				const title = document.querySelector('.about-title');
				title.addEventListener('click', function() {
					this.style.animation = 'titleFloat 0.5s ease-in-out';
					setTimeout(() => {
						this.style.animation = 'neonGlow 2s ease-in-out infinite, titleFloat 4s ease-in-out infinite';
					}, 500);
				});
			});
		</script>
	</body>
</html>
