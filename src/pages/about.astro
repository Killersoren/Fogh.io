---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About - BALD SOFTWARE GUY" description="Learn more about the most fabulous bald software developer" />
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap');
			
			:root {
				--rainbow-red: #ff0000;
				--rainbow-orange: #ff8000;
				--rainbow-yellow: #ffff00;
				--rainbow-green: #00ff00;
				--rainbow-blue: #0080ff;
				--rainbow-purple: #8000ff;
				--rainbow-pink: #ff0080;
				--dark-bg: #0a0a0a;
			}

			body {
				background: var(--dark-bg);
				color: white;
				font-family: 'Space Mono', monospace;
				margin: 0;
				overflow-x: hidden;
			}

			/* SUPER GAY DICK CONFETTI */
			.dick-confetti-container {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				pointer-events: none;
				z-index: 100;
				overflow: hidden;
			}

			.dick-confetti {
				position: absolute;
				font-size: 1.5rem;
				animation: dickFall 8s linear infinite;
				opacity: 0.8;
			}

			.dick-confetti:nth-child(odd) {
				animation-duration: 6s;
				color: var(--rainbow-pink);
			}

			.dick-confetti:nth-child(even) {
				animation-duration: 7s;
				color: var(--rainbow-blue);
			}

			.dick-confetti:nth-child(3n) {
				animation-duration: 9s;
				color: var(--rainbow-green);
			}

			.dick-confetti:nth-child(4n) {
				animation-duration: 5s;
				color: var(--rainbow-yellow);
			}

			.dick-confetti:nth-child(5n) {
				animation-duration: 10s;
				color: var(--rainbow-purple);
			}

			/* RAINBOW PARTICLE BACKGROUND */
			.particle-container {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				z-index: 1;
				pointer-events: none;
			}

			.particle {
				position: absolute;
				width: 4px;
				height: 4px;
				border-radius: 50%;
				animation: particleFloat 8s linear infinite;
			}

			.particle:nth-child(6n+1) { background: var(--rainbow-red); animation-duration: 6s; }
			.particle:nth-child(6n+2) { background: var(--rainbow-orange); animation-duration: 7s; }
			.particle:nth-child(6n+3) { background: var(--rainbow-yellow); animation-duration: 8s; }
			.particle:nth-child(6n+4) { background: var(--rainbow-green); animation-duration: 9s; }
			.particle:nth-child(6n+5) { background: var(--rainbow-blue); animation-duration: 10s; }
			.particle:nth-child(6n+6) { background: var(--rainbow-purple); animation-duration: 11s; }

			/* RAINBOW SCANNING LINES */
			.scan-line {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 2px;
				z-index: 2;
				animation: scanLine 3s linear infinite;
			}

			.scan-line:nth-child(1) {
				background: linear-gradient(90deg, transparent, var(--rainbow-red), transparent);
			}

			.scan-line:nth-child(2) {
				animation-delay: 1s;
				background: linear-gradient(90deg, transparent, var(--rainbow-orange), transparent);
			}

			.scan-line:nth-child(3) {
				animation-delay: 2s;
				background: linear-gradient(90deg, transparent, var(--rainbow-yellow), transparent);
			}

			.scan-line:nth-child(4) {
				animation-delay: 3s;
				background: linear-gradient(90deg, transparent, var(--rainbow-green), transparent);
			}

			.scan-line:nth-child(5) {
				animation-delay: 4s;
				background: linear-gradient(90deg, transparent, var(--rainbow-blue), transparent);
			}

			.scan-line:nth-child(6) {
				animation-delay: 5s;
				background: linear-gradient(90deg, transparent, var(--rainbow-purple), transparent);
			}

			.about-section {
				min-height: 100vh;
				padding: 8rem 2rem 4rem;
				position: relative;
				background: linear-gradient(45deg, #000000, #1a1a1a, #000000);
				overflow: hidden;
				z-index: 10;
			}

			/* RAINBOW HOLOGRAPHIC GRID */
			.holographic-grid {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				opacity: 0.2;
				z-index: 1;
				background-image: 
					linear-gradient(rgba(255, 0, 255, 0.1) 1px, transparent 1px),
					linear-gradient(90deg, rgba(255, 0, 255, 0.1) 1px, transparent 1px);
				background-size: 50px 50px;
				animation: gridPulse 4s ease-in-out infinite;
			}

			.about-content {
				max-width: 1200px;
				margin: 0 auto;
				position: relative;
				z-index: 20;
			}

			.about-title {
				text-align: center;
				font-family: 'Orbitron', monospace;
				font-size: 4rem;
				font-weight: 900;
				margin-bottom: 3rem;
				background: linear-gradient(45deg, var(--rainbow-red), var(--rainbow-orange), var(--rainbow-yellow), var(--rainbow-green), var(--rainbow-blue), var(--rainbow-purple));
				background-size: 300% 300%;
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				animation: neonGlow 2s ease-in-out infinite, titleFloat 4s ease-in-out infinite;
				text-shadow: 
					0 0 20px var(--rainbow-pink),
					0 0 40px var(--rainbow-pink),
					0 0 60px var(--rainbow-pink);
			}

			.about-subtitle {
				text-align: center;
				font-size: 1.5rem;
				color: var(--rainbow-yellow);
				margin-bottom: 4rem;
				animation: subtitlePulse 2s ease-in-out infinite;
				text-shadow: 0 0 15px var(--rainbow-yellow);
			}

			.about-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
				gap: 3rem;
				margin-bottom: 4rem;
			}

			.about-card {
				background: rgba(255, 0, 255, 0.1);
				padding: 2.5rem;
				border-radius: 20px;
				border: 3px solid var(--rainbow-pink);
				position: relative;
				overflow: hidden;
				animation: cardFloat 5s ease-in-out infinite;
				transition: all 0.3s ease;
				text-align: center;
			}

			.about-card::before {
				content: '';
				position: absolute;
				top: 0;
				left: -100%;
				width: 100%;
				height: 100%;
				background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
				transition: left 0.5s ease;
			}

			.about-card:hover {
				transform: scale(1.05) rotate(2deg);
				box-shadow: 
					0 0 30px var(--rainbow-pink),
					0 0 60px var(--rainbow-blue);
				border-color: var(--rainbow-blue);
			}

			.about-card:hover::before {
				left: 100%;
			}

			.card-icon {
				font-size: 4rem;
				margin-bottom: 1.5rem;
				animation: iconRotate 10s linear infinite;
				filter: drop-shadow(0 0 15px var(--rainbow-pink));
			}

			.card-title {
				font-family: 'Orbitron', monospace;
				font-size: 1.8rem;
				color: var(--rainbow-pink);
				margin-bottom: 1rem;
				text-shadow: 0 0 10px var(--rainbow-pink);
			}

			.card-description {
				font-size: 1.1rem;
				line-height: 1.6;
				color: white;
			}

			.skills-section {
				margin: 4rem 0;
			}

			.skills-title {
				text-align: center;
				font-family: 'Orbitron', monospace;
				font-size: 2.5rem;
				color: var(--rainbow-blue);
				margin-bottom: 3rem;
				text-shadow: 0 0 15px var(--rainbow-blue);
				animation: titleGlow 3s ease-in-out infinite;
			}

			.skills-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 2rem;
			}

			.skill-card {
				background: rgba(0, 255, 255, 0.1);
				padding: 2rem;
				border-radius: 15px;
				border: 2px solid var(--rainbow-blue);
				text-align: center;
				animation: skillFloat 4s ease-in-out infinite;
				transition: all 0.3s ease;
				position: relative;
				overflow: hidden;
			}

			.skill-card::before {
				content: '';
				position: absolute;
				top: 0;
				left: -100%;
				width: 100%;
				height: 100%;
				background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.2), transparent);
				transition: left 0.5s ease;
			}

			.skill-card:hover {
				transform: scale(1.1) rotate(5deg);
				box-shadow: 
					0 0 25px var(--rainbow-blue),
					0 0 50px var(--rainbow-green);
				border-color: var(--rainbow-green);
			}

			.skill-card:hover::before {
				left: 100%;
			}

			.skill-name {
				font-family: 'Orbitron', monospace;
				font-size: 1.3rem;
				color: var(--rainbow-blue);
				margin-bottom: 1rem;
				text-shadow: 0 0 10px var(--rainbow-blue);
			}

			.skill-level {
				width: 100%;
				height: 8px;
				background: rgba(255, 255, 255, 0.1);
				border-radius: 4px;
				overflow: hidden;
				position: relative;
			}

			.skill-progress {
				height: 100%;
				background: linear-gradient(90deg, var(--rainbow-blue), var(--rainbow-green));
				border-radius: 4px;
				animation: progressGlow 2s ease-in-out infinite;
			}

			.timeline-section {
				margin: 4rem 0;
			}

			.timeline-title {
				text-align: center;
				font-family: 'Orbitron', monospace;
				font-size: 2.5rem;
				color: var(--rainbow-green);
				margin-bottom: 3rem;
				text-shadow: 0 0 15px var(--rainbow-green);
				animation: titleGlow 3s ease-in-out infinite;
			}

			.timeline {
				position: relative;
				max-width: 800px;
				margin: 0 auto;
			}

			.timeline::before {
				content: '';
				position: absolute;
				left: 50%;
				top: 0;
				bottom: 0;
				width: 4px;
				background: linear-gradient(to bottom, var(--rainbow-green), var(--rainbow-blue), var(--rainbow-purple));
				transform: translateX(-50%);
				animation: timelineGlow 3s ease-in-out infinite;
			}

			.timeline-item {
				position: relative;
				margin: 3rem 0;
				width: 45%;
				animation: timelineFloat 6s ease-in-out infinite;
			}

			.timeline-item:nth-child(odd) {
				left: 0;
				text-align: right;
			}

			.timeline-item:nth-child(even) {
				left: 55%;
				text-align: left;
			}

			.timeline-content {
				background: rgba(0, 255, 0, 0.1);
				padding: 2rem;
				border-radius: 15px;
				border: 2px solid var(--rainbow-green);
				position: relative;
				transition: all 0.3s ease;
			}

			.timeline-content::before {
				content: '';
				position: absolute;
				top: 50%;
				width: 20px;
				height: 20px;
				background: var(--rainbow-green);
				border-radius: 50%;
				transform: translateY(-50%);
				box-shadow: 0 0 15px var(--rainbow-green);
				animation: timelineDot 2s ease-in-out infinite;
			}

			.timeline-item:nth-child(odd) .timeline-content::before {
				right: -60px;
			}

			.timeline-item:nth-child(even) .timeline-content::before {
				left: -60px;
			}

			.timeline-content:hover {
				transform: scale(1.05);
				box-shadow: 
					0 0 25px var(--rainbow-green),
					0 0 50px var(--rainbow-blue);
				border-color: var(--rainbow-blue);
			}

			.timeline-year {
				font-family: 'Orbitron', monospace;
				font-size: 1.2rem;
				color: var(--rainbow-green);
				margin-bottom: 0.5rem;
				text-shadow: 0 0 10px var(--rainbow-green);
			}

			.timeline-title {
				font-size: 1.3rem;
				color: white;
				margin-bottom: 0.5rem;
			}

			.timeline-description {
				font-size: 1rem;
				color: #ccc;
			}

			/* SUPER GAY ANIMATIONS */
			@keyframes dickFall {
				0% { 
					transform: translateY(-100vh) translateX(0px) rotate(0deg); 
					opacity: 0; 
				}
				10% { opacity: 1; }
				90% { opacity: 1; }
				100% { 
					transform: translateY(100vh) translateX(100px) rotate(360deg); 
					opacity: 0; 
				}
			}

			@keyframes neonGlow {
				0%, 100% { background-position: 0% 50%; }
				50% { background-position: 100% 50%; }
			}

			@keyframes titleFloat {
				0%, 100% { transform: translateY(0px) rotate(0deg); }
				50% { transform: translateY(-10px) rotate(1deg); }
			}

			@keyframes subtitlePulse {
				0%, 100% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.8; transform: scale(1.02); }
			}

			@keyframes particleFloat {
				0% { transform: translateY(100vh) translateX(0px); opacity: 0; }
				10% { opacity: 1; }
				90% { opacity: 1; }
				100% { transform: translateY(-100px) translateX(100px); opacity: 0; }
			}

			@keyframes scanLine {
				0% { transform: translateY(-100vh); }
				100% { transform: translateY(100vh); }
			}

			@keyframes gridPulse {
				0%, 100% { opacity: 0.2; }
				50% { opacity: 0.4; }
			}

			@keyframes cardFloat {
				0%, 100% { transform: translateY(0px) rotate(0deg); }
				50% { transform: translateY(-10px) rotate(1deg); }
			}

			@keyframes iconRotate {
				from { transform: rotate(0deg); }
				to { transform: rotate(360deg); }
			}

			@keyframes titleGlow {
				0%, 100% { text-shadow: 0 0 15px currentColor; }
				50% { text-shadow: 0 0 25px currentColor, 0 0 35px currentColor; }
			}

			@keyframes skillFloat {
				0%, 100% { transform: translateY(0px) rotate(0deg); }
				50% { transform: translateY(-8px) rotate(2deg); }
			}

			@keyframes progressGlow {
				0%, 100% { box-shadow: 0 0 10px var(--rainbow-blue); }
				50% { box-shadow: 0 0 20px var(--rainbow-blue), 0 0 30px var(--rainbow-green); }
			}

			@keyframes timelineGlow {
				0%, 100% { box-shadow: 0 0 10px var(--rainbow-green); }
				50% { box-shadow: 0 0 20px var(--rainbow-green), 0 0 30px var(--rainbow-blue); }
			}

			@keyframes timelineFloat {
				0%, 100% { transform: translateY(0px); }
				50% { transform: translateY(-5px); }
			}

			@keyframes timelineDot {
				0%, 100% { transform: translateY(-50%) scale(1); }
				50% { transform: translateY(-50%) scale(1.2); }
			}

			@media (max-width: 768px) {
				.about-title {
					font-size: 2.5rem;
				}

				.about-subtitle {
					font-size: 1.2rem;
				}

				.about-grid {
					grid-template-columns: 1fr;
					gap: 2rem;
				}

				.about-card {
					padding: 2rem;
				}

				.card-icon {
					font-size: 3rem;
				}

				.skills-grid {
					grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
					gap: 1.5rem;
				}

				.timeline::before {
					left: 20px;
				}

				.timeline-item {
					width: 100%;
					left: 0 !important;
					text-align: left !important;
					padding-left: 60px;
				}

				.timeline-item .timeline-content::before {
					left: -40px !important;
				}
			}
		</style>
	</head>
	<body>
		<Header title="About" />
		
		<!-- SUPER GAY DICK CONFETTI -->
		<div class="dick-confetti-container" id="dickConfetti"></div>
		
		<!-- RAINBOW PARTICLE BACKGROUND -->
		<div class="particle-container" id="particles"></div>
		
		<!-- RAINBOW SCANNING LINES -->
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		<div class="scan-line"></div>
		
		<section class="about-section">
			<div class="holographic-grid"></div>
			
			<div class="about-content">
				<h1 class="about-title">ABOUT THE BALD LEGEND</h1>
				<p class="about-subtitle">Discover the fabulous journey of the most epic bald software developer! 🌈✨</p>
				
				<div class="about-grid">
					<div class="about-card">
						<div class="card-icon">👨‍🦲</div>
						<h3 class="card-title">The Bald Identity</h3>
						<p class="card-description">
							I'm not just bald by choice - I'm bald by destiny! My smooth head reflects the clean, efficient code I write. 
							No hair to get in the way of my programming prowess! 💪
						</p>
					</div>
					
					<div class="about-card">
						<div class="card-icon">🌈</div>
						<h3 class="card-title">Pride & Code</h3>
						<p class="card-description">
							Proud to be a gay software developer! I bring color, creativity, and fabulousness to every project. 
							Love is love, and code is beautiful! 🏳️‍🌈
						</p>
					</div>
					
					<div class="about-card">
						<div class="card-icon">🚀</div>
						<h3 class="card-title">Tech Enthusiast</h3>
						<p class="card-description">
							From frontend to backend, I make it all work seamlessly. Always exploring new technologies 
							and pushing the boundaries of what's possible! ⚡
						</p>
					</div>
					
					<div class="about-card">
						<div class="card-icon">🎯</div>
						<h3 class="card-title">Problem Solver</h3>
						<p class="card-description">
							Debugging is my superpower! I find bugs faster than you can say "it works on my machine." 
							No problem is too complex for this bald brain! 🧠
						</p>
					</div>
					
					<div class="about-card">
						<div class="card-icon">💡</div>
						<h3 class="card-title">Innovation Enthusiast</h3>
						<p class="card-description">
							Always thinking outside the box and coming up with creative solutions. 
							Innovation is my middle name (well, not really, but it should be)! ✨
						</p>
					</div>
					
					<div class="about-card">
						<div class="card-icon">🍆</div>
						<h3 class="card-title">Dick Confetti Master</h3>
						<p class="card-description">
							Creator of the most epic dick confetti system ever! Because why not make websites 
							more fabulous with tiny animated dicks? It's art! 🎨
						</p>
					</div>
				</div>
				
				<div class="skills-section">
					<h2 class="skills-title">MY FABULOUS SKILLS</h2>
					<div class="skills-grid">
						<div class="skill-card">
							<div class="skill-name">JavaScript</div>
							<div class="skill-level">
								<div class="skill-progress" style="width: 95%;"></div>
							</div>
						</div>
						
						<div class="skill-card">
							<div class="skill-name">TypeScript</div>
							<div class="skill-level">
								<div class="skill-progress" style="width: 90%;"></div>
							</div>
						</div>
						
						<div class="skill-card">
							<div class="skill-name">React</div>
							<div class="skill-level">
								<div class="skill-progress" style="width: 88%;"></div>
							</div>
						</div>
						
						<div class="skill-card">
							<div class="skill-name">Node.js</div>
							<div class="skill-level">
								<div class="skill-progress" style="width: 85%;"></div>
							</div>
						</div>
						
						<div class="skill-card">
							<div class="skill-name">Python</div>
							<div class="skill-level">
								<div class="skill-progress" style="width: 80%;"></div>
							</div>
						</div>
						
						<div class="skill-card">
							<div class="skill-name">AWS</div>
							<div class="skill-level">
								<div class="skill-progress" style="width: 75%;"></div>
							</div>
						</div>
						
						<div class="skill-card">
							<div class="skill-name">CSS/SCSS</div>
							<div class="skill-level">
								<div class="skill-progress" style="width: 92%;"></div>
							</div>
						</div>
						
						<div class="skill-card">
							<div class="skill-name">Git</div>
							<div class="skill-level">
								<div class="skill-progress" style="width: 87%;"></div>
							</div>
						</div>
					</div>
				</div>
				
				<div class="timeline-section">
					<h2 class="timeline-title">MY EPIC JOURNEY</h2>
					<div class="timeline">
						<div class="timeline-item">
							<div class="timeline-content">
								<div class="timeline-year">2020</div>
								<h3 class="timeline-title">The Bald Awakening</h3>
								<p class="timeline-description">Discovered my true calling as a bald software developer. The head shaving ceremony was epic!</p>
							</div>
						</div>
						
						<div class="timeline-item">
							<div class="timeline-content">
								<div class="timeline-year">2021</div>
								<h3 class="timeline-title">Rainbow Code Revolution</h3>
								<p class="timeline-description">Started making everything SUPER GAY! Rainbow colors everywhere, because why not?</p>
							</div>
						</div>
						
						<div class="timeline-item">
							<div class="timeline-content">
								<div class="timeline-year">2022</div>
