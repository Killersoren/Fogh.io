---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">👨‍🦲 BALD SOFTWARE GUY</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://github.com" target="_blank" class="social-link">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
				</svg>
			</a>
			<a href="https://linkedin.com" target="_blank" class="social-link">
				<span class="sr-only">LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path fill="currentColor" d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"></path>
				</svg>
			</a>
			<a href="https://twitter.com" target="_blank" class="social-link">
				<span class="sr-only">Twitter</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path fill="currentColor" d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"></path>
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: linear-gradient(90deg, #0a0a0a, #1a1a1a, #0a0a0a);
		border-bottom: 3px solid #00ffff;
		box-shadow: 
			0 0 20px rgba(0, 255, 255, 0.5),
			0 0 40px rgba(0, 255, 255, 0.3),
			0 0 60px rgba(0, 255, 255, 0.1);
		position: sticky;
		top: 0;
		z-index: 1000;
		position: relative;
		overflow: hidden;
	}
	
	header::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.1), transparent);
		animation: headerScan 4s linear infinite;
	}
	
	h2 {
		margin: 0;
		font-size: 1.4em;
		font-family: 'Orbitron', monospace;
		font-weight: 900;
		animation: titlePulse 2s ease-in-out infinite;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: #00ffff;
		text-shadow: 
			0 0 10px #00ffff,
			0 0 20px #00ffff,
			0 0 30px #00ffff;
		transition: all 0.3s ease;
		position: relative;
	}
	
	h2 a::before {
		content: '👨‍🦲 BALD SOFTWARE GUY';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(45deg, #ff00ff, #00ffff, #00ff00);
		background-size: 200% 200%;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: neonGlow 3s ease-in-out infinite;
		filter: blur(2px);
		z-index: -1;
	}
	
	h2 a:hover {
		color: #ff00ff;
		text-shadow: 
			0 0 15px #ff00ff,
			0 0 30px #ff00ff,
			0 0 45px #ff00ff;
		transform: scale(1.05);
	}
	
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}
	
	nav a {
		padding: 1em 0.5em;
		color: #ffffff;
		border-bottom: 4px solid transparent;
		text-decoration: none;
		transition: all 0.3s ease;
		font-weight: 500;
		position: relative;
		overflow: hidden;
	}
	
	nav a::before {
		content: '';
		position: absolute;
		bottom: 0;
		left: -100%;
		width: 100%;
		height: 2px;
		background: linear-gradient(90deg, #00ffff, #ff00ff, #00ff00);
		transition: left 0.3s ease;
	}
	
	nav a:hover {
		color: #00ffff;
		border-bottom-color: #00ffff;
		text-shadow: 0 0 10px #00ffff;
		transform: translateY(-2px);
	}
	
	nav a:hover::before {
		left: 0;
	}
	
	nav a.active {
		text-decoration: none;
		border-bottom-color: #00ffff;
		color: #00ffff;
		text-shadow: 0 0 10px #00ffff;
		animation: activeGlow 2s ease-in-out infinite;
	}
	
	.internal-links {
		display: flex;
		gap: 1.5rem;
	}
	
	.social-links {
		display: flex;
		gap: 1.5rem;
	}
	
	.social-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 45px;
		height: 45px;
		border-radius: 50%;
		background: rgba(0, 255, 255, 0.1);
		border: 3px solid #00ffff;
		color: #00ffff;
		transition: all 0.4s ease;
		position: relative;
		overflow: hidden;
		animation: socialFloat 4s ease-in-out infinite;
	}
	
	.social-link::before {
		content: '';
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.5), transparent);
		transition: left 0.5s ease;
	}
	
	.social-link::after {
		content: '';
		position: absolute;
		top: -2px;
		left: -2px;
		right: -2px;
		bottom: -2px;
		border-radius: 50%;
		background: linear-gradient(45deg, #00ffff, #ff00ff, #00ff00);
		background-size: 200% 200%;
		animation: borderRotate 3s linear infinite;
		z-index: -1;
	}
	
	.social-link:hover {
		background: #00ffff;
		color: #0a0a0a;
		transform: scale(1.2) rotate(10deg);
		box-shadow: 
			0 0 20px #00ffff,
			0 0 40px #00ffff,
			0 0 60px #00ffff;
	}
	
	.social-link:hover::before {
		left: 100%;
	}
	
	/* INTENSE ANIMATIONS */
	@keyframes headerScan {
		0% { transform: translateX(-100%); }
		100% { transform: translateX(100%); }
	}
	
	@keyframes titlePulse {
		0%, 100% { transform: scale(1); }
		50% { transform: scale(1.02); }
	}
	
	@keyframes neonGlow {
		0%, 100% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
	}
	
	@keyframes activeGlow {
		0%, 100% { text-shadow: 0 0 10px #00ffff; }
		50% { text-shadow: 0 0 20px #00ffff, 0 0 30px #00ffff; }
	}
	
	@keyframes socialFloat {
		0%, 100% { transform: translateY(0px) rotate(0deg); }
		50% { transform: translateY(-3px) rotate(2deg); }
	}
	
	@keyframes borderRotate {
		0% { background: linear-gradient(0deg, #00ffff, #ff00ff, #00ff00); }
		25% { background: linear-gradient(90deg, #ff00ff, #00ff00, #00ffff); }
		50% { background: linear-gradient(180deg, #00ff00, #00ffff, #ff00ff); }
		75% { background: linear-gradient(270deg, #00ffff, #ff00ff, #00ff00); }
		100% { background: linear-gradient(360deg, #00ffff, #ff00ff, #00ff00); }
	}
	
	@media (max-width: 720px) {
		.internal-links {
			display: none;
		}
		
		h2 {
			font-size: 1.1em;
		}
		
		.social-links {
			gap: 1rem;
		}
		
		.social-link {
			width: 40px;
			height: 40px;
		}
	}
</style>
