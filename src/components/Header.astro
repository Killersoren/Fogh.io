---
export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<header class="header">
	<div class="header-content">
		<div class="logo-section">
			<a href="/" class="logo">
				<span class="logo-text">BALD SOFTWARE GUY</span>
				<span class="logo-emoji">👨‍🦲</span>
			</a>
		</div>
		
		<nav class="nav">
			<a href="/" class="nav-link">🏠 Home</a>
			<a href="/about" class="nav-link">👨‍🦲 About</a>
			<a href="/blog" class="nav-link">📝 Blog</a>
			<a href="/contact" class="nav-link">💌 Contact</a>
		</nav>
		
		<div class="pride-flags">
			<div class="flag rainbow-flag">🏳️‍🌈</div>
			<div class="flag trans-flag">🏳️‍⚧️</div>
			<div class="flag bi-flag">💖💜💙</div>
			<div class="flag gay-flag">🌈</div>
		</div>
	</div>
	
	<!-- RAINBOW SCANNING LINES -->
	<div class="header-scan-line"></div>
	<div class="header-scan-line"></div>
	<div class="header-scan-line"></div>
</header>

<style>
	:root {
		--rainbow-red: #ff0000;
		--rainbow-orange: #ff8000;
		--rainbow-yellow: #ffff00;
		--rainbow-green: #00ff00;
		--rainbow-blue: #0080ff;
		--rainbow-purple: #8000ff;
		--rainbow-pink: #ff0080;
		--dark-bg: #0a0a0a;
	}

	.header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		background: linear-gradient(90deg, 
			rgba(255, 0, 0, 0.9), 
			rgba(255, 128, 0, 0.9), 
			rgba(255, 255, 0, 0.9), 
			rgba(0, 255, 0, 0.9), 
			rgba(0, 128, 255, 0.9), 
			rgba(128, 0, 255, 0.9), 
			rgba(255, 0, 128, 0.9));
		backdrop-filter: blur(10px);
		border-bottom: 3px solid var(--rainbow-pink);
		z-index: 1000;
		overflow: hidden;
		box-shadow: 
			0 0 20px var(--rainbow-pink),
			0 0 40px var(--rainbow-blue),
			0 0 60px var(--rainbow-green);
	}

	.header::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(45deg, 
			transparent 30%, 
			rgba(255, 255, 255, 0.1) 50%, 
			transparent 70%);
		animation: headerShimmer 3s ease-in-out infinite;
	}

	.header-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1rem 2rem;
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}

	.logo-section {
		position: relative;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 1rem;
		text-decoration: none;
		color: white;
		font-family: 'Orbitron', monospace;
		font-weight: 900;
		font-size: 1.5rem;
		position: relative;
		animation: logoPulse 2s ease-in-out infinite;
	}

	.logo-text {
		background: linear-gradient(45deg, 
			var(--rainbow-red), 
			var(--rainbow-orange), 
			var(--rainbow-yellow), 
			var(--rainbow-green), 
			var(--rainbow-blue), 
			var(--rainbow-purple));
		background-size: 300% 300%;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: neonGlow 2s ease-in-out infinite;
		text-shadow: 0 0 15px var(--rainbow-pink);
	}

	.logo-emoji {
		font-size: 2rem;
		animation: rotate 10s linear infinite, emojiBounce 1s ease-in-out infinite;
		filter: drop-shadow(0 0 10px var(--rainbow-pink));
	}

	.nav {
		display: flex;
		gap: 2rem;
		align-items: center;
	}

	.nav-link {
		color: white;
		text-decoration: none;
		font-family: 'Space Mono', monospace;
		font-weight: bold;
		font-size: 1.1rem;
		padding: 0.8rem 1.5rem;
		border-radius: 25px;
		background: rgba(255, 0, 255, 0.2);
		border: 2px solid var(--rainbow-pink);
		transition: all 0.3s ease;
		position: relative;
		overflow: hidden;
		animation: navFloat 4s ease-in-out infinite;
		text-shadow: 0 0 10px var(--rainbow-pink);
	}

	.nav-link::before {
		content: '';
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
		transition: left 0.5s ease;
	}

	.nav-link:hover {
		background: var(--rainbow-pink);
		color: var(--dark-bg);
		transform: scale(1.1) rotate(5deg);
		box-shadow: 
			0 0 20px var(--rainbow-pink),
			0 0 40px var(--rainbow-blue);
		border-color: var(--rainbow-blue);
	}

	.nav-link:hover::before {
		left: 100%;
	}

	.nav-link:nth-child(1) { animation-delay: 0s; }
	.nav-link:nth-child(2) { animation-delay: 0.5s; }
	.nav-link:nth-child(3) { animation-delay: 1s; }
	.nav-link:nth-child(4) { animation-delay: 1.5s; }

	.pride-flags {
		display: flex;
		gap: 1rem;
		align-items: center;
	}

	.flag {
		font-size: 1.5rem;
		animation: flagWave 3s ease-in-out infinite;
		filter: drop-shadow(0 0 10px var(--rainbow-pink));
	}

	.flag:nth-child(1) { animation-delay: 0s; }
	.flag:nth-child(2) { animation-delay: 0.5s; }
	.flag:nth-child(3) { animation-delay: 1s; }
	.flag:nth-child(4) { animation-delay: 1.5s; }

	/* RAINBOW SCANNING LINES */
	.header-scan-line {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 2px;
		background: linear-gradient(90deg, transparent, var(--rainbow-pink), transparent);
		animation: headerScanLine 2s linear infinite;
		z-index: 1;
	}

	.header-scan-line:nth-child(2) {
		animation-delay: 0.5s;
		background: linear-gradient(90deg, transparent, var(--rainbow-blue), transparent);
	}

	.header-scan-line:nth-child(3) {
		animation-delay: 1s;
		background: linear-gradient(90deg, transparent, var(--rainbow-green), transparent);
	}

	/* SUPER GAY ANIMATIONS */
	@keyframes headerShimmer {
		0%, 100% { transform: translateX(-100%); }
		50% { transform: translateX(100%); }
	}

	@keyframes logoPulse {
		0%, 100% { transform: scale(1); }
		50% { transform: scale(1.05); }
	}

	@keyframes neonGlow {
		0%, 100% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
	}

	@keyframes rotate {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	@keyframes emojiBounce {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-5px); }
	}

	@keyframes navFloat {
		0%, 100% { transform: translateY(0px) rotate(0deg); }
		50% { transform: translateY(-5px) rotate(2deg); }
	}

	@keyframes flagWave {
		0%, 100% { transform: rotate(0deg) scale(1); }
		50% { transform: rotate(10deg) scale(1.2); }
	}

	@keyframes headerScanLine {
		0% { transform: translateX(-100%); }
		100% { transform: translateX(100%); }
	}

	@media (max-width: 768px) {
		.header-content {
			flex-direction: column;
			gap: 1rem;
			padding: 1rem;
		}

		.nav {
			gap: 1rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		.nav-link {
			font-size: 0.9rem;
			padding: 0.6rem 1rem;
		}

		.logo-text {
			font-size: 1.2rem;
		}

		.pride-flags {
			gap: 0.5rem;
		}

		.flag {
			font-size: 1.2rem;
		}
	}
</style>
