---
export interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<footer class="footer">
	<div class="footer-content">
		<div class="footer-section">
			<h3 class="footer-title">BALD SOFTWARE GUY</h3>
			<p class="footer-subtitle">Making the web fabulous, one line of code at a time! 🌈✨</p>
		</div>
		
		<div class="footer-section">
			<h4 class="section-title">Connect With Me</h4>
			<div class="social-links">
				<a href="https://github.com" target="_blank" class="social-link" title="GitHub">
					<span class="social-icon">🐙</span>
					<span class="social-text">GitHub</span>
				</a>
				<a href="https://linkedin.com" target="_blank" class="social-link" title="LinkedIn">
					<span class="social-icon">💼</span>
					<span class="social-text">LinkedIn</span>
				</a>
				<a href="https://twitter.com" target="_blank" class="social-link" title="Twitter">
					<span class="social-icon">🐦</span>
					<span class="social-text">Twitter</span>
				</a>
				<a href="mailto:hello@baldsoftwareguy.com" class="social-link" title="Email">
					<span class="social-icon">💌</span>
					<span class="social-text">Email</span>
				</a>
			</div>
		</div>
		
		<div class="footer-section">
			<h4 class="section-title">Pride & Joy</h4>
			<div class="pride-message">
				<p>🌈 Proud to be a bald, gay software developer! 🏳️‍🌈</p>
				<p>Love is love, code is code, and both are beautiful! 💖</p>
			</div>
		</div>
	</div>
	
	<div class="footer-bottom">
		<div class="footer-info">
			<p>&copy; 2024 Bald Software Guy. Built with ❤️ and lots of 🌈</p>
			<p>Powered by Astro, fueled by coffee, styled with fabulousness!</p>
		</div>
		
		<div class="pride-flags-footer">
			<div class="flag">🏳️‍🌈</div>
			<div class="flag">🏳️‍⚧️</div>
			<div class="flag">💖💜💙</div>
			<div class="flag">🌈</div>
			<div class="flag">🍆</div>
			<div class="flag">✨</div>
		</div>
	</div>
	
	<!-- RAINBOW SCANNING LINES -->
	<div class="footer-scan-line"></div>
	<div class="footer-scan-line"></div>
	<div class="footer-scan-line"></div>
</footer>

<style>
	:root {
		--rainbow-red: #ff0000;
		--rainbow-orange: #ff8000;
		--rainbow-yellow: #ffff00;
		--rainbow-green: #00ff00;
		--rainbow-blue: #0080ff;
		--rainbow-purple: #8000ff;
		--rainbow-pink: #ff0080;
		--dark-bg: #0a0a0a;
	}

	.footer {
		background: linear-gradient(135deg, 
			rgba(255, 0, 0, 0.9), 
			rgba(255, 128, 0, 0.9), 
			rgba(255, 255, 0, 0.9), 
			rgba(0, 255, 0, 0.9), 
			rgba(0, 128, 255, 0.9), 
			rgba(128, 0, 255, 0.9), 
			rgba(255, 0, 128, 0.9));
		color: white;
		padding: 3rem 0 1rem;
		position: relative;
		overflow: hidden;
		border-top: 3px solid var(--rainbow-pink);
		box-shadow: 
			0 0 20px var(--rainbow-pink),
			0 0 40px var(--rainbow-blue),
			0 0 60px var(--rainbow-green);
	}

	.footer::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(45deg, 
			transparent 30%, 
			rgba(255, 255, 255, 0.1) 50%, 
			transparent 70%);
		animation: footerShimmer 4s ease-in-out infinite;
	}

	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 3rem;
		position: relative;
		z-index: 2;
	}

	.footer-section {
		text-align: center;
	}

	.footer-title {
		font-family: 'Orbitron', monospace;
		font-size: 2rem;
		font-weight: 900;
		margin-bottom: 1rem;
		background: linear-gradient(45deg, 
			var(--rainbow-red), 
			var(--rainbow-orange), 
			var(--rainbow-yellow), 
			var(--rainbow-green), 
			var(--rainbow-blue), 
			var(--rainbow-purple));
		background-size: 300% 300%;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: neonGlow 2s ease-in-out infinite;
		text-shadow: 0 0 15px var(--rainbow-pink);
	}

	.footer-subtitle {
		font-size: 1.1rem;
		color: var(--rainbow-yellow);
		margin-bottom: 2rem;
		animation: subtitlePulse 2s ease-in-out infinite;
		text-shadow: 0 0 10px var(--rainbow-yellow);
	}

	.section-title {
		font-family: 'Orbitron', monospace;
		font-size: 1.3rem;
		color: var(--rainbow-pink);
		margin-bottom: 1.5rem;
		text-shadow: 0 0 10px var(--rainbow-pink);
		animation: titleFloat 3s ease-in-out infinite;
	}

	.social-links {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}

	.social-link {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		color: white;
		text-decoration: none;
		padding: 1rem 1.5rem;
		background: rgba(255, 0, 255, 0.2);
		border: 2px solid var(--rainbow-pink);
		border-radius: 25px;
		transition: all 0.3s ease;
		position: relative;
		overflow: hidden;
		animation: socialFloat 4s ease-in-out infinite;
		text-shadow: 0 0 10px var(--rainbow-pink);
		min-width: 150px;
		justify-content: center;
	}

	.social-link::before {
		content: '';
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
		transition: left 0.5s ease;
	}

	.social-link:hover {
		background: var(--rainbow-pink);
		color: var(--dark-bg);
		transform: scale(1.1) rotate(5deg);
		box-shadow: 
			0 0 20px var(--rainbow-pink),
			0 0 40px var(--rainbow-blue);
		border-color: var(--rainbow-blue);
	}

	.social-link:hover::before {
		left: 100%;
	}

	.social-icon {
		font-size: 1.5rem;
		animation: iconBounce 1s ease-in-out infinite;
	}

	.social-text {
		font-family: 'Space Mono', monospace;
		font-weight: bold;
		font-size: 1rem;
	}

	.pride-message {
		background: rgba(255, 0, 255, 0.1);
		padding: 1.5rem;
		border-radius: 15px;
		border: 2px solid var(--rainbow-pink);
		animation: prideGlow 3s ease-in-out infinite;
	}

	.pride-message p {
		margin: 0.5rem 0;
		font-size: 1rem;
		color: var(--rainbow-yellow);
		text-shadow: 0 0 10px var(--rainbow-yellow);
	}

	.footer-bottom {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 2px solid rgba(255, 255, 255, 0.2);
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 2rem;
		position: relative;
		z-index: 2;
	}

	.footer-info {
		text-align: center;
		flex: 1;
	}

	.footer-info p {
		margin: 0.5rem 0;
		font-size: 0.9rem;
		color: var(--rainbow-yellow);
		text-shadow: 0 0 8px var(--rainbow-yellow);
	}

	.pride-flags-footer {
		display: flex;
		gap: 1rem;
		align-items: center;
		flex-wrap: wrap;
		justify-content: center;
	}

	.flag {
		font-size: 1.5rem;
		animation: flagWave 3s ease-in-out infinite;
		filter: drop-shadow(0 0 10px var(--rainbow-pink));
	}

	.flag:nth-child(1) { animation-delay: 0s; }
	.flag:nth-child(2) { animation-delay: 0.5s; }
	.flag:nth-child(3) { animation-delay: 1s; }
	.flag:nth-child(4) { animation-delay: 1.5s; }
	.flag:nth-child(5) { animation-delay: 2s; }
	.flag:nth-child(6) { animation-delay: 2.5s; }

	/* RAINBOW SCANNING LINES */
	.footer-scan-line {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 2px;
		background: linear-gradient(90deg, transparent, var(--rainbow-pink), transparent);
		animation: footerScanLine 2s linear infinite;
		z-index: 1;
	}

	.footer-scan-line:nth-child(2) {
		animation-delay: 0.5s;
		background: linear-gradient(90deg, transparent, var(--rainbow-blue), transparent);
	}

	.footer-scan-line:nth-child(3) {
		animation-delay: 1s;
		background: linear-gradient(90deg, transparent, var(--rainbow-green), transparent);
	}

	/* SUPER GAY ANIMATIONS */
	@keyframes footerShimmer {
		0%, 100% { transform: translateX(-100%); }
		50% { transform: translateX(100%); }
	}

	@keyframes neonGlow {
		0%, 100% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
	}

	@keyframes subtitlePulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.8; transform: scale(1.02); }
	}

	@keyframes titleFloat {
		0%, 100% { transform: translateY(0px) rotate(0deg); }
		50% { transform: translateY(-5px) rotate(2deg); }
	}

	@keyframes socialFloat {
		0%, 100% { transform: translateY(0px) rotate(0deg); }
		50% { transform: translateY(-8px) rotate(3deg); }
	}

	@keyframes iconBounce {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-3px); }
	}

	@keyframes prideGlow {
		0%, 100% { 
			box-shadow: 0 0 10px var(--rainbow-pink);
			border-color: var(--rainbow-pink);
		}
		50% { 
			box-shadow: 0 0 20px var(--rainbow-pink), 0 0 30px var(--rainbow-blue);
			border-color: var(--rainbow-blue);
		}
	}

	@keyframes flagWave {
		0%, 100% { transform: rotate(0deg) scale(1); }
		50% { transform: rotate(10deg) scale(1.2); }
	}

	@keyframes footerScanLine {
		0% { transform: translateX(-100%); }
		100% { transform: translateX(100%); }
	}

	@media (max-width: 768px) {
		.footer-content {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding: 0 1rem;
		}

		.footer-title {
			font-size: 1.5rem;
		}

		.footer-subtitle {
			font-size: 1rem;
		}

		.social-links {
			gap: 0.8rem;
		}

		.social-link {
			padding: 0.8rem 1.2rem;
			min-width: 120px;
		}

		.footer-bottom {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}

		.pride-flags-footer {
			gap: 0.5rem;
		}

		.flag {
			font-size: 1.2rem;
		}
	}
</style>
